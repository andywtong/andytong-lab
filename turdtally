    function togglePause() {
      if (!AppState.currentSession.active) return;
      sound.playChime();
      AppState.currentSession.paused = !AppState.currentSession.paused;

      const pauseIcon = document.getElementById('pauseBtnIcon');
      const pauseText = document.getElementById('pauseBtnText');
      const dot = document.getElementById('sessionStatusDot');
      const text = document.getElementById('sessionStatusText');

      if (AppState.currentSession.paused) {
        pauseIcon.textContent = '▶️';
        pauseText.textContent = 'Resume Mission';
        dot.className = 'w-3 h-3 rounded-full bg-amber-400';
        text.textContent = 'Holding It (Paused)';
        text.className = 'text-xs font-bold tracking-wider uppercase text-amber-600';
      } else {
        pauseIcon.textContent = '⏸️';
        pauseText.textContent = 'Hold It (Pause)';
        dot.className = 'w-3 h-3 rounded-full bg-emerald-500 animate-pulse';
        text.textContent = 'Mission In Progress';
        text.className = 'text-xs font-bold tracking-wider uppercase text-emerald-600';

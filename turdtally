<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TurdTally — Real-Time Throne Wealth & Open Reading Lounge</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            display: ['Fredoka', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
            sans: ['Plus Jakarta Sans', 'sans-serif'],
          },
          colors: {
            ambergold: '#f59e0b',
            surface: '#1e293b',
            surfacelight: '#334155'
          }
        }
      }
    }
  </script>

  <style>
    /* Sleek custom scrollbars */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: #0f172a; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #475569; }

    @keyframes pulse-gentle {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.88; transform: scale(1.02); }
    }
    .animate-badge { animation: pulse-gentle 2s infinite ease-in-out; }
  </style>
</head>
<body class="bg-[#0b1120] text-slate-100 font-sans min-h-screen flex flex-col selection:bg-amber-500 selection:text-slate-900 pb-16">

  <!-- ================= STICKY TOP HUD ================= -->
  <div id="stickyHud" class="sticky top-0 z-40 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 shadow-xl py-2 px-4 transition-all">
    <div class="max-w-5xl mx-auto flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="text-2xl">🧻</span>
        <div>
          <div class="text-[10px] font-bold uppercase tracking-wider text-amber-400">TurdTally HUD</div>
          <div class="font-mono text-sm font-bold text-slate-200">
            <span id="hudTimer">00:00:00</span>
          </div>
        </div>
      </div>

      <!-- Quick Metrics -->
      <div class="flex items-center gap-3 sm:gap-4 text-xs font-mono">
        <div class="bg-slate-800/80 px-3 py-1 rounded-lg border border-slate-700/60">
          <span class="text-slate-400">Earned:</span>
          <span id="hudEarned" class="text-emerald-400 font-bold ml-1">$0.00</span>
        </div>
        <div class="bg-slate-800/80 px-3 py-1 rounded-lg border border-slate-700/60">
          <span class="text-slate-400">TP:</span>
          <span id="hudPoints" class="text-amber-400 font-bold ml-1">0</span>
        </div>
      </div>

      <!-- Quick Toggle Action Button -->
      <div class="flex items-center gap-2">
        <button id="hudActionBtn" onclick="toggleMissionPrimary()" class="bg-amber-500 hover:bg-amber-400 active:scale-95 text-slate-950 font-display font-bold text-sm px-4 py-1.5 rounded-xl transition-all shadow-md">
          Initiate Mission
        </button>
      </div>
    </div>
  </div>

  <!-- ================= LOCAL SESSION TELEMETRY BAR ================= -->
  <div class="bg-slate-950 border-b border-slate-800/80 text-xs py-1.5 px-4">
    <div class="max-w-5xl mx-auto flex items-center justify-between overflow-hidden">
      <div class="flex items-center gap-2 shrink-0">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span class="font-semibold text-slate-400 uppercase tracking-widest text-[10px]">Session Telemetry</span>
      </div>
      <div id="telemetryTicker" class="truncate text-slate-400 text-center mx-4 font-mono text-[11px]">
        🚽 Welcome to TurdTally. Clock in, relax, and reclaim your workplace compensation.
      </div>
      <div class="shrink-0 text-[11px] text-slate-500 font-mono hidden sm:inline">
        100% Private &amp; Local
      </div>
    </div>
  </div>

  <!-- ================= MAIN CONTAINER ================= -->
  <main class="max-w-5xl mx-auto px-4 pt-6 flex-1 w-full space-y-6">

    <!-- Header & Throne Identity Moniker -->
    <header class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-surface p-4 rounded-2xl border border-slate-800 shadow-md">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-3xl shadow-inner">
          🧻
        </div>
        <div>
          <h1 class="text-2xl font-display font-bold tracking-tight text-white flex items-center gap-2">
            TurdTally
            <span class="text-[11px] font-sans font-semibold tracking-normal bg-amber-500/20 text-amber-300 border border-amber-500/40 px-2 py-0.5 rounded-full">v3.0 Live Press</span>
          </h1>
          <p class="text-xs text-slate-400">The Workplace Throne Wealth, Telemetry &amp; Journalism Hub</p>
        </div>
      </div>

      <!-- Throne Name Badge & Edit -->
      <div class="flex items-center gap-2 bg-slate-900/80 px-3 py-2 rounded-xl border border-slate-800 text-xs w-full sm:w-auto justify-between sm:justify-start">
        <div class="flex items-center gap-2">
          <span class="text-base">👑</span>
          <div>
            <div class="text-[10px] text-slate-400 font-semibold uppercase">Throne Moniker</div>
            <span id="displayThroneName" class="font-bold text-amber-300 font-mono">PlungerPat_42</span>
          </div>
        </div>
        <button onclick="promptChangeThroneName()" class="text-slate-400 hover:text-white px-2.5 py-1 bg-slate-800 hover:bg-slate-700 rounded-lg text-[11px] font-semibold transition">
          Edit
        </button>
      </div>
    </header>

    <!-- ================= PROMINENT WAGE CONFIGURATION BANNER ================= -->
    <section class="bg-gradient-to-r from-amber-500/15 via-slate-800/60 to-emerald-500/15 border-2 border-amber-500/30 rounded-2xl p-4 sm:p-5 shadow-lg flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-4 w-full md:w-auto">
        <div class="w-12 h-12 rounded-xl bg-amber-500 text-slate-950 font-black text-2xl flex items-center justify-center shrink-0 shadow-md">
          $
        </div>
        <div>
          <div class="text-xs uppercase font-extrabold tracking-wider text-amber-400">Active Earning Rate</div>
          <div class="flex flex-wrap items-baseline gap-2">
            <span id="bannerWageDisplay" class="font-mono text-2xl md:text-3xl font-extrabold text-white">$45.00</span>
            <span class="text-slate-400 text-xs font-semibold">/ hour</span>
            <span class="text-slate-500 text-xs font-mono">(≈ <span id="bannerPerSecondDisplay" class="text-emerald-400 font-bold">$0.0125</span> / sec)</span>
          </div>
        </div>
      </div>
      <button onclick="openWageModal()" class="w-full md:w-auto bg-amber-500 hover:bg-amber-400 text-slate-950 font-display font-bold px-5 py-2.5 rounded-xl shadow-lg hover:shadow-amber-500/20 active:scale-95 transition-all flex items-center justify-center gap-2 shrink-0">
        <span>✏️ Adjust Wage / Salary</span>
      </button>
    </section>

    <!-- ================= TRACKING ENGINE DASHBOARD ================= -->
    <section class="bg-surface border border-slate-800 rounded-3xl p-5 sm:p-6 shadow-2xl relative overflow-hidden">
      
      <!-- Reading bonus promo notice -->
      <div class="mb-6 bg-slate-900/80 border border-amber-500/30 rounded-2xl p-3 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
        <div class="flex items-center gap-3 text-slate-300">
          <span class="text-2xl shrink-0">🛋️</span>
          <div>
            <strong class="text-amber-400">Throne Reading Bonus:</strong> Read live journalism stories in the Lounge during an active mission to earn <span class="bg-amber-500/20 text-amber-300 px-1.5 py-0.5 rounded font-mono font-bold">+10 TP</span> every 15 seconds.
          </div>
        </div>
        <button onclick="scrollToReadingLounge()" class="w-full sm:w-auto bg-slate-800 hover:bg-slate-700 text-amber-300 font-semibold px-3 py-1.5 rounded-lg border border-slate-700 whitespace-nowrap transition text-center shrink-0">
          Browse Newsroom ↓
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 mb-8 text-center">
        <!-- Duration -->
        <div class="bg-slate-900/90 p-5 rounded-2xl border border-slate-800/80 flex flex-col justify-center">
          <span class="text-xs uppercase tracking-wider text-slate-400 font-bold mb-1">Session Duration</span>
          <div id="mainTimerDisplay" class="font-mono text-3xl lg:text-4xl font-extrabold text-white tracking-tight">00:00:00</div>
          <span id="sessionStatusPill" class="mt-2 inline-block text-[10px] uppercase font-bold tracking-widest text-slate-500 bg-slate-800 px-2 py-0.5 rounded-full mx-auto">Standby</span>
        </div>

        <!-- Corporate Wealth -->
        <div class="bg-slate-900/90 p-5 rounded-2xl border border-slate-800/80 flex flex-col justify-center">
          <span class="text-xs uppercase tracking-wider text-emerald-400 font-bold mb-1">Corporate Pay Reclaimed</span>
          <div id="mainEarnedDisplay" class="font-mono text-3xl lg:text-4xl font-extrabold text-emerald-400 tracking-tight">$0.000</div>
          <span class="mt-2 text-[10px] text-slate-400 font-mono">Real-time sub-cent tally</span>
        </div>

        <!-- Point Breakdown -->
        <div class="bg-slate-900/90 p-5 rounded-2xl border border-slate-800/80 flex flex-col justify-center">
          <span class="text-xs uppercase tracking-wider text-amber-400 font-bold mb-1">Total TurdPoints™</span>
          <div id="mainPointsDisplay" class="font-mono text-3xl lg:text-4xl font-extrabold text-amber-400 tracking-tight">0</div>
          <div class="mt-2 flex items-center justify-center gap-2 text-[10px] font-mono text-slate-400">
            <span>Throne Time: <b id="subPoopPoints" class="text-slate-300">0</b></span>
            <span>•</span>
            <span>Reading: <b id="subReadingPoints" class="text-amber-300">0</b></span>
          </div>
        </div>
      </div>

      <!-- Mission Controls -->
      <div class="flex flex-wrap items-center justify-center gap-3">
        <button id="btnStart" onclick="startMission()" class="flex-1 min-w-[140px] bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-display font-bold py-3 px-6 rounded-2xl text-base shadow-lg transition active:scale-95 flex items-center justify-center gap-2">
          <span>🚀 Initiate Mission</span>
        </button>

        <button id="btnPause" onclick="pauseMission()" disabled class="bg-slate-800 hover:bg-slate-700 disabled:opacity-40 disabled:pointer-events-none text-slate-200 font-display font-semibold py-3 px-5 rounded-2xl text-sm border border-slate-700 transition active:scale-95">
          <span id="pauseBtnLabel">⏸️ Hold It</span>
        </button>

        <button id="btnAbort" onclick="abortMission()" disabled class="bg-slate-800 hover:bg-rose-950/60 disabled:opacity-40 disabled:pointer-events-none text-rose-300 font-display font-semibold py-3 px-5 rounded-2xl text-sm border border-slate-700 hover:border-rose-800/50 transition active:scale-95">
          🛑 Abort
        </button>

        <button id="btnFlush" onclick="flushAndLogSession()" disabled class="flex-1 min-w-[160px] bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 disabled:opacity-40 disabled:pointer-events-none text-slate-950 font-display font-extrabold py-3 px-6 rounded-2xl text-base shadow-xl transition active:scale-95 flex items-center justify-center gap-2">
          <span>🚽 Flush &amp; Log</span>
        </button>
      </div>
    </section>

    <!-- ================= THRONE READING LOUNGE (LIVE JOURNALISM) ================= -->
    <section id="readingLoungeSection" class="bg-surface border border-slate-800 rounded-3xl p-5 sm:p-6 shadow-xl space-y-6">
      
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-4">
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-xl font-display font-bold text-white">🛋️ Throne Reading Lounge</h2>
            <span class="bg-emerald-500/20 text-emerald-300 text-[10px] font-bold px-2 py-0.5 rounded-full border border-emerald-500/40">● Live Open Wire</span>
          </div>
          <p class="text-xs text-slate-400">Live, unabridged human journalism retrieved dynamically via open press APIs. Zero AI filler, zero paywalls.</p>
        </div>

        <!-- Controls: Refresh & Topic Customizer -->
        <div class="flex items-center gap-2">
          <button id="refreshBtn" onclick="refreshCategoryStories()" class="text-xs bg-slate-800 hover:bg-slate-700 text-slate-200 px-3.5 py-2 rounded-xl border border-slate-700 font-semibold transition flex items-center gap-2 active:scale-95 shadow">
            <span id="refreshIcon">🔄</span>
            <span>Refresh Stories</span>
          </button>
          <button onclick="openCategoryCustomizerModal()" class="text-xs bg-slate-800 hover:bg-slate-700 text-slate-200 px-3.5 py-2 rounded-xl border border-slate-700 font-semibold transition flex items-center gap-1.5 shadow">
            <span>⚙️ Manage Topics</span>
          </button>
        </div>
      </div>

      <!-- Categories Navigation Bar (Top 5 Pinned Favorites) -->
      <div id="categoryTabBar" class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
        <!-- Rendered by JS -->
      </div>

      <!-- Loading State Indicator -->
      <div id="articlesLoading" class="hidden py-12 text-center space-y-3">
        <div class="w-8 h-8 border-2 border-amber-500 border-t-transparent rounded-full animate-spin mx-auto"></div>
        <p class="text-xs text-slate-400 font-mono">Fetching full dispatches from live human press wires...</p>
      </div>

      <!-- Articles Grid (3 Per Category) -->
      <div id="articlesGrid" class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Rendered by JS -->
      </div>

    </section>

    <!-- ================= LIFETIME REPUTATION & LOGS ================= -->
    <section class="bg-surface border border-slate-800 rounded-3xl p-5 sm:p-6 shadow-xl space-y-4">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 class="text-base font-display font-bold text-white flex items-center gap-2">
          <span>📜 Local Throne Archives</span>
        </h3>
        <button onclick="clearSessionHistory()" class="text-[11px] text-slate-500 hover:text-rose-400 transition">
          Clear Logs
        </button>
      </div>

      <!-- Lifetime Stats Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
        <div class="bg-slate-900/60 p-3 rounded-xl border border-slate-800">
          <div class="text-[10px] uppercase font-bold text-slate-400">Career Reclaimed</div>
          <div id="statCareerEarnings" class="text-lg font-mono font-bold text-emerald-400">$0.00</div>
        </div>
        <div class="bg-slate-900/60 p-3 rounded-xl border border-slate-800">
          <div class="text-[10px] uppercase font-bold text-slate-400">Career Dwell Time</div>
          <div id="statCareerTime" class="text-lg font-mono font-bold text-slate-200">0h 0m</div>
        </div>
        <div class="bg-slate-900/60 p-3 rounded-xl border border-slate-800">
          <div class="text-[10px] uppercase font-bold text-slate-400">Lifetime Points</div>
          <div id="statCareerPoints" class="text-lg font-mono font-bold text-amber-400">0</div>
        </div>
        <div class="bg-slate-900/60 p-3 rounded-xl border border-slate-800">
          <div class="text-[10px] uppercase font-bold text-slate-400">Total Flushes</div>
          <div id="statTotalFlushes" class="text-lg font-mono font-bold text-white">0</div>
        </div>
      </div>

      <!-- Recent Log Table -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs font-mono">
          <thead class="bg-slate-900/80 text-slate-400 uppercase text-[10px] border-b border-slate-800">
            <tr>
              <th class="py-2.5 px-3">Date</th>
              <th class="py-2.5 px-3">Duration</th>
              <th class="py-2.5 px-3">Earnings</th>
              <th class="py-2.5 px-3">Points (Throne / Read)</th>
              <th class="py-2.5 px-3">Total</th>
            </tr>
          </thead>
          <tbody id="historyTableBody" class="divide-y divide-slate-800/60 text-slate-300">
            <!-- Rendered by JS -->
          </tbody>
        </table>
      </div>
    </section>

    <!-- ================= SPONSORSHIP / MONETIZATION BANNER ================= -->
    <footer class="bg-slate-900/60 border border-slate-800 rounded-2xl p-4 text-center text-xs text-slate-400 flex flex-col sm:flex-row items-center justify-between gap-3">
      <div>
        <span class="font-bold text-amber-400">Sponsor This Porcelain Real Estate:</span> Reach corporate professionals during their most focused minutes.
      </div>
      <a href="mailto:sponsor@turdtally.app?subject=Porcelain%20Ad%20Inquiry" rel="noopener noreferrer" class="bg-slate-800 hover:bg-slate-700 text-amber-300 font-semibold px-4 py-1.5 rounded-lg border border-slate-700 transition">
        Inquire for Ad Space
      </a>
    </footer>

  </main>

  <!-- ================= UNABRIDGED IN-APP ARTICLE SANDBOX READER MODAL ================= -->
  <div id="readerModal" class="fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-md flex items-center justify-center p-3 sm:p-4 hidden">
    <div class="bg-surface border border-slate-700 max-w-3xl w-full max-h-[92vh] rounded-3xl shadow-2xl flex flex-col overflow-hidden animate-in fade-in zoom-in duration-200">
      
      <!-- Reader Header -->
      <div class="bg-slate-900 p-4 border-b border-slate-800 flex items-center justify-between gap-2 shrink-0">
        <div class="flex items-center gap-2 truncate">
          <span id="readerCategoryBadge" class="bg-amber-500/20 text-amber-300 text-xs font-bold px-2 py-0.5 rounded font-mono shrink-0">Tech</span>
          <span id="readerProvenanceBadge" class="text-[11px] font-bold px-2.5 py-0.5 rounded-full border border-emerald-500/40 bg-emerald-500/20 text-emerald-300 shrink-0">✓ Live Human Journalism</span>
        </div>

        <!-- Dwell Timer & Points Bonus -->
        <div id="readerBonusTracker" class="flex items-center gap-2 bg-slate-800/80 px-3 py-1 rounded-xl border border-slate-700 text-xs font-mono shrink-0">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
          <span class="text-slate-300 hidden sm:inline">Next +10 TP:</span>
          <span id="readerCountdown" class="text-amber-400 font-bold">15s</span>
        </div>

        <button onclick="closeReaderModal()" class="text-slate-400 hover:text-white p-1 rounded-lg text-lg hover:bg-slate-800 transition shrink-0">
          ✕
        </button>
      </div>

      <!-- Reader Scrollable Body (Entire Article) -->
      <div id="readerScrollContent" class="p-6 sm:p-8 overflow-y-auto space-y-6 text-slate-300 text-sm sm:text-base leading-relaxed">
        <div class="space-y-2">
          <h2 id="readerTitle" class="text-2xl sm:text-3xl font-display font-extrabold text-white tracking-tight leading-snug"></h2>
          <div class="flex flex-wrap items-center gap-3 text-xs text-slate-400 font-mono border-b border-slate-800 pb-4">
            <span id="readerAuthor" class="text-slate-300 font-medium">By Human Reporter</span>
            <span>•</span>
            <span id="readerSourceOrg" class="text-amber-400 font-semibold">Wikinews Open Wire</span>
            <span>•</span>
            <span id="readerTimestamp">Live Dispatch</span>
            <span>•</span>
            <span id="readerReadTime">Full Unabridged Text</span>
          </div>
        </div>

        <!-- Article Body Paragraphs -->
        <div id="readerBodyText" class="space-y-5 text-slate-200 font-sans leading-relaxed tracking-normal">
          <!-- Full article paragraphs dynamically injected here -->
        </div>

        <!-- Attribution Box -->
        <div class="bg-slate-900/90 p-4 rounded-2xl border border-slate-800 text-xs text-slate-400 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-bold uppercase tracking-wider text-[10px] text-amber-400">Journalistic Reference &amp; Verified Public Archive</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800">100% Non-AI</span>
          </div>
          <div class="text-[11px] text-slate-300">
            Source Link: <a id="readerExternalLink" href="#" target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:underline break-all font-mono">Original Public Record</a>
          </div>
          <p class="text-[10px] text-slate-500">Unabridged story loaded live via open public journalism APIs. Points accumulate continuously while open during an active mission.</p>
        </div>
      </div>

      <!-- Reader Footer -->
      <div class="bg-slate-900 p-3 sm:p-4 border-t border-slate-800 flex items-center justify-between text-xs text-slate-400 shrink-0">
        <span class="text-[11px] font-mono text-emerald-400 truncate mr-2">🟢 Dwell counter active: +10 TP every 15s</span>
        <button onclick="closeReaderModal()" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-4 py-2 rounded-xl transition shrink-0 shadow">
          Done Reading
        </button>
      </div>

    </div>
  </div>

  <!-- ================= WAGE CONFIG MODAL ================= -->
  <div id="wageModal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 hidden">
    <div class="bg-surface border border-slate-700 max-w-md w-full rounded-3xl p-6 shadow-2xl space-y-5">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 class="font-display font-bold text-lg text-white">💰 Compensation Settings</h3>
        <button onclick="closeWageModal()" class="text-slate-400 hover:text-white">✕</button>
      </div>

      <div class="grid grid-cols-2 gap-2 bg-slate-900 p-1 rounded-xl">
        <button id="calcModeHourly" onclick="setWageCalculationMode('hourly')" class="py-1.5 text-xs font-bold rounded-lg bg-amber-500 text-slate-950 transition">Hourly Wage</button>
        <button id="calcModeSalary" onclick="setWageCalculationMode('salary')" class="py-1.5 text-xs font-bold rounded-lg text-slate-400 hover:text-white transition">Annual Salary</button>
      </div>

      <div>
        <label id="wageInputLabel" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Hourly Rate ($)</label>
        <div class="relative">
          <span class="absolute left-3 top-2.5 text-slate-400 font-mono font-bold">$</span>
          <input type="number" id="inputWageAmount" step="0.5" min="1" max="10000000" class="w-full bg-slate-900 border border-slate-700 rounded-xl py-2 pl-8 pr-4 text-white font-mono font-bold focus:border-amber-400 outline-none text-base" value="45.00">
        </div>
      </div>

      <div class="bg-slate-900/60 p-3 rounded-xl border border-slate-800 text-xs font-mono space-y-1">

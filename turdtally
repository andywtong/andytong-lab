          { title: "Neuromorphic Chip Emulates Synaptic Plasticity with Sub-Milliwatt Efficiency", author: "Devon Chen", min: 3, lead: "A research team synthesized memristor arrays that learn sensory patterns natively without algorithmic backpropagation passes.", p2: "By processing continuous spike intervals, the chip consumes a fraction of traditional GPU clusters for computer vision." },
          { title: "Synthesized Voice Models Achieve Imperceptible Conversational Latency Under 90ms", author: "Rachel Vance", min: 4, lead: "Low-overhead streaming transformers eliminated the conversational lag that previously broke conversational realism in audio agents.", p2: "Developers describe natural speech turn-taking and prosody modulation as key advancements for accessibility tools." }
        ]
      },
      gaming: {
        sources: ['IGN', 'Polygon', 'Kotaku', 'Eurogamer', 'PC Gamer'],
        articles: [
          { title: "Next-Gen Physics Engines Introduce Real-Time Volumetric Fluid & Aerodynamics", author: "Leo Ortiz", min: 3, lead: "Game engine developers showcased fully dynamic weather simulation where wind pressures calculate localized ballistics in real time.", p2: "Indie developers are adopting the middleware to build unprecedented environmental navigation mechanics." },
          { title: "Restoration Team Recovers Lost 1994 Unreleased Arcade Prototype From Abandoned Warehouse", author: "Sam Tanaka", min: 4, lead: "Archivists successfully dumped EPROM chips from an experimental vector cabinet once thought to be pure industry rumor.", p2: "The museum team plans to release emulated source code alongside high-resolution documentation for public preservation." }
        ]
      },
      popculture: {
        sources: ['Variety', 'Rolling Stone', 'The Hollywood Reporter', 'Billboard'],
        articles: [
          { title: "Analog Synthesizer Renaissance Sparks Surging Vinyl Cassette Resurgence Among Gen Z", author: "Maya Brooks", min: 3, lead: "Independent recording artists are intentionally mastering on magnetic tape to bypass sterile digital normalization curves.", p2: "Physical cassette production facilities in North America report year-long backorders for boutique limited pressings." },
          { title: "Practical Effects Comeback: Studio Blockbusters Pivot Away From Full-CGI Sets", author: "Elliot Vance", min: 4, lead: "Cinematographers praise tactile animatronics and miniature rear-projections for restoring authentic lighting physics on screen.", p2: "Directors note actor performance and presence improved dramatically when interacting with real physical set designs." }
        ]
      },
      sports: {
        sources: ['The Athletic', 'ESPN', 'Bleacher Report', 'Sky Sports'],
        articles: [
          { title: "Biomechanic Sensor Fabric Detects Soft-Tissue Fatigue Before Athlete Symptoms Appear", author: "Derrick Cole", min: 3, lead: "Premier League training facilities deployed micro-filament jerseys monitoring muscle strain and asymmetric stride patterns.", p2: "Early preventative resting interventions cut rotational hamstring injuries across the squad by nearly half." },
          { title: "High-Altitude Aerodynamic Helmets Revolutionize Track Cycling World Records", author: "Fiona MacLeod", min: 3, lead: "Wind tunnel computational fluid dynamics sculpted radical geometric profiles that reduce drag coefficients by 7%.", p2: "Olympic velodrome competitors achieved unprecedented lap velocities during this weekend's world cup qualifiers." }
        ]
      }
    };

    let activeCategory = 'tech';

    function getArticlesForCategory(catId) {
      // Check default catalog or generate procedural placeholder for custom category
      const data = TOPIC_TEMPLATES[catId];
      if (data) {
        // Randomize list order slightly to make it feel fresh
        return [...data.articles].sort(() => 0.5 - Math.random()).map(a => ({
          ...a,
          source: data.sources[Math.floor(Math.random() * data.sources.length)],
          date: 'Just now'
        }));
      }

      // Procedural generation for custom user-requested categories
      const cleanName = catId.charAt(0).toUpperCase() + catId.slice(1);
      return [
        {
          title: `Breakthrough Developments and Modern Trends in ${cleanName}`,
          source: `${cleanName} Chronicle`,
          author: "Field Analyst",
          min: 3,
          date: 'Just now',
          lead: `Pioneering initiatives across the global ${cleanName} landscape are accelerating research, capital efficiency, and public engagement.`,
          p2: `Specialists point to cross-disciplinary collaboration and novel tooling as the core catalysts reshaping standards over the coming decade.`
        },
        {
          title: `How Contemporary Leaders Are Rethinking Core ${cleanName} Strategies`,
          source: `${cleanName} Weekly`,
          author: "Industry Bureau",
          min: 4,
          date: 'Today',
          lead: `A new comprehensive market report documents how technological shifts are creating unexpected advantages for agile practitioners in ${cleanName}.`,
          p2: `By adopting responsive workflows, forward-looking groups have unlocked substantial efficiency while mitigating structural headwinds.`
        }
      ];
    }

    function renderCategoryTabs() {
      const container = document.getElementById('categoryTabs');
      if (!container) return;

      const topicsToRender = AppState.user.selectedTopics.slice(0, 5);
      
      // Ensure active category is valid
      if (!topicsToRender.includes(activeCategory) && topicsToRender.length > 0) {
        activeCategory = topicsToRender[0];
      }

      container.innerHTML = topicsToRender.map(topicId => {
        const found = ALL_AVAILABLE_TOPICS.find(t => t.id === topicId);
        const label = found ? found.label : `🏷️ ${topicId.charAt(0).toUpperCase() + topicId.slice(1)}`;
        const isActive = topicId === activeCategory;
        const btnClass = isActive 
          ? 'cat-btn px-3.5 py-1.5 rounded-xl bg-amber-800 text-white font-bold shadow-xs shrink-0 transition'
          : 'cat-btn px-3.5 py-1.5 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200 shrink-0 transition font-medium';

        return `<button data-cat="${topicId}" class="${btnClass}">${label}</button>`;
      }).join('');

      // Attach click events
      container.querySelectorAll('.cat-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          activeCategory = btn.dataset.cat;
          sound.playChime();
          renderCategoryTabs();
          loadDispatches(activeCategory);
        });
      });
    }

    function loadDispatches(category) {
      const feedContainer = document.getElementById('newsFeedList');
      if (!feedContainer) return;

      const articles = getArticlesForCategory(category);

      feedContainer.innerHTML = articles.map((art, index) => `
        <div class="p-3.5 rounded-2xl bg-slate-50 hover:bg-amber-50/70 border border-slate-200/80 hover:border-amber-200 transition group cursor-pointer" onclick="openReaderModal('${category}', ${index})">
          <div class="flex items-center justify-between text-[11px] text-slate-400 mb-1">
            <span class="font-bold text-amber-900">${escapeHtml(art.source)}</span>
            <span>${escapeHtml(art.min)} min read</span>
          </div>
          <h4 class="font-display font-semibold text-slate-800 text-sm group-hover:text-amber-900 leading-snug mb-1">
            ${escapeHtml(art.title)}
          </h4>
          <p class="text-xs text-slate-600 line-clamp-2">
            ${escapeHtml(art.lead)}
          </p>
          <div class="mt-2.5 flex items-center justify-between text-[11px]">
            <span class="text-emerald-700 font-bold flex items-center gap-1">
              <span>📖</span> Earns +10 TP / 15s in reader
            </span>
            <span class="text-amber-800 font-bold group-hover:translate-x-0.5 transition flex items-center gap-0.5">
              Open Reader ↗
            </span>
          </div>
        </div>
      `).join('');
    }

    // Opens sandboxed reader modal and initiates active dwell-time tracker
    window.openReaderModal = function(category, articleIndex) {
      sound.playChime();
      const articles = getArticlesForCategory(category);
      const article = articles[articleIndex];
      if (!article) return;

      AppState.reader.isOpen = true;
      AppState.reader.activeArticle = article;
      AppState.reader.dwellTimer = 15; // Reset dwell loop

      document.getElementById('readerModalCategory').textContent = category.toUpperCase();
      document.getElementById('readerModalSource').textContent = article.source;
      document.getElementById('readerModalTime').textContent = `${article.min} min read`;
      document.getElementById('readerModalTitle').textContent = article.title;
      document.getElementById('readerModalAuthor').textContent = article.author || 'Senior Correspondent';
      document.getElementById('readerModalDate').textContent = article.date || 'Today';

      document.getElementById('readerModalContent').innerHTML = `
        <p class="font-semibold text-slate-800 text-base leading-relaxed">${escapeHtml(article.lead)}</p>
        <p>${escapeHtml(article.p2 || "The strategic implications of this shift are reverberating across industry leaders, sparking spirited debate on upcoming regulatory frameworks and technical benchmarks.")}</p>
        <p>Market observers stress that early adoption patterns indicate this trend will outlast temporary cyclical fluctuations. As teams integrate more streamlined tooling, the threshold for operational efficiency continues to rise across global competitive sectors.</p>
        <p>Future releases and updates are slated for deployment in the coming quarter, with industry symposiums slated to review real-world telemetry and validated outcomes.</p>
      `;

      const dwellText = document.getElementById('dwellCountdownText');
      if (dwellText) {
        dwellText.textContent = AppState.currentSession.active ? 'Next +10 TP: 15s' : 'Start mission to earn';
      }

      document.getElementById('readerModal').classList.remove('hidden');

      if (AppState.currentSession.active && !AppState.currentSession.paused) {
        document.getElementById('activeReaderIndicator').classList.remove('hidden');
      }
    };

    function closeReaderModal() {
      AppState.reader.isOpen = false;
      AppState.reader.activeArticle = null;
      document.getElementById('readerModal').classList.add('hidden');
      document.getElementById('activeReaderIndicator').classList.add('hidden');
    }

    /* ==========================================================================
       5. LOCAL LEADERBOARD & STATS DASHBOARD
       ========================================================================== */
    function renderHistoryAndStats() {
      const totalSessions = AppState.sessions.length;
      let totalPay = 0;
      let totalSec = 0;

      AppState.sessions.forEach(s => {
        totalPay += (s.earnings || 0);
        totalSec += (s.durationSeconds || 0);
      });

      const avgPay = totalSessions > 0 ? (totalPay / totalSessions) : 0;
      const totalMinutes = Math.round(totalSec / 60);

      document.getElementById('statTotalPay').textContent = `$${totalPay.toFixed(2)}`;
      document.getElementById('statTotalFlushes').textContent = totalSessions;
      document.getElementById('statTotalTime').textContent = `${totalMinutes}m`;
      document.getElementById('statAvgValue').textContent = `$${avgPay.toFixed(2)}`;

      const rankBadge = document.getElementById('profileRankBadge');
      if (rankBadge) {
        if (totalSessions >= 25) rankBadge.textContent = 'Grand Porcelain Sovereign 👑';
        else if (totalSessions >= 10) rankBadge.textContent = 'Senior Wealth Reclamation Officer 🎖️';
        else if (totalSessions >= 3) rankBadge.textContent = 'Certified Throne Operator 🧻';
        else rankBadge.textContent = 'Junior Flush Officer 🚽';
      }

      const sorted = [...AppState.sessions];
      if (currentSortMode === 'earnings') {
        sorted.sort((a, b) => (b.earnings || 0) - (a.earnings || 0));
      } else if (currentSortMode === 'points') {
        sorted.sort((a, b) => (b.points || 0) - (a.points || 0));
      } else {
        sorted.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
      }

      const listContainer = document.getElementById('sessionHistoryList');
      if (!listContainer) return;

      if (sorted.length === 0) {
        listContainer.innerHTML = `
          <div class="text-center py-8 text-slate-400">
            <span class="text-3xl block mb-1">📭</span>
            <p class="text-xs">No recorded flushes yet. Initiate a mission and reclaim your first corporate dollar!</p>
          </div>
        `;
        return;
      }

      listContainer.innerHTML = sorted.map((s, idx) => {
        const medal = idx === 0 ? '🥇' : idx === 1 ? '🥈' : idx === 2 ? '🥉' : `#${idx + 1}`;
        const dateStr = new Date(s.timestamp).toLocaleDateString(undefined, {
          month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'
        });

        return `
          <div class="flex items-center justify-between p-3 rounded-2xl bg-amber-50/50 hover:bg-amber-100/40 border border-amber-100/60 transition text-xs">
            <div class="flex items-center gap-3">
              <span class="font-display font-bold text-sm w-6 text-center text-amber-900">${medal}</span>
              <div>
                <span class="font-display font-semibold text-slate-800 text-sm block">${escapeHtml(s.throneName || 'ThroneWarrior')}</span>
                <span class="text-[10px] text-slate-400">${dateStr} • Duration: ${formatDurationClean(s.durationSeconds)}</span>
              </div>
            </div>
            <div class="text-right">
              <span class="font-mono font-bold text-emerald-600 text-sm block">+$${Number(s.earnings || 0).toFixed(2)}</span>
              <span class="font-mono text-[11px] font-semibold text-amber-700">${s.points || 0} TP</span>
            </div>
          </div>
        `;
      }).join('');
    }

    function escapeHtml(str) {
      return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    /* ==========================================================================
       6. TOPIC CUSTOMIZATION MODAL ENGINE
       ========================================================================== */
    function renderTopicsCustomizer() {
      const grid = document.getElementById('topicsGrid');
      if (!grid) return;

      // Merge defaults with any user added custom categories
      const allTopics = [...ALL_AVAILABLE_TOPICS];
      AppState.user.customCategories.forEach(c => {
        if (!allTopics.some(t => t.id === c)) {
          allTopics.push({ id: c, label: `🏷️ ${c.charAt(0).toUpperCase() + c.slice(1)}` });
        }
      });

      grid.innerHTML = allTopics.map(t => {
        const isChecked = AppState.user.selectedTopics.includes(t.id);
        return `
          <label class="flex items-center gap-2 p-2.5 rounded-xl border ${isChecked ? 'bg-amber-50 border-amber-300 font-bold text-amber-950' : 'bg-slate-50 border-slate-200 text-slate-600'} cursor-pointer transition">
            <input type="checkbox" value="${t.id}" class="topic-checkbox rounded text-amber-600 focus:ring-amber-500" ${isChecked ? 'checked' : ''}>
            <span class="truncate">${t.label}</span>
          </label>
        `;
      }).join('');

      document.getElementById('selectedTopicsCount').textContent = AppState.user.selectedTopics.length;

      grid.querySelectorAll('.topic-checkbox').forEach(box => {
        box.addEventListener('change', (e) => {
          const checked = Array.from(grid.querySelectorAll('.topic-checkbox:checked')).map(cb => cb.value);
          if (checked.length > 5) {
            e.target.checked = false;
            alert("Please pick a maximum of 5 favorite topics for the throne lounge bar.");
            return;
          }
          document.getElementById('selectedTopicsCount').textContent = checked.length;
        });
      });
    }

    /* ==========================================================================
       7. UI EVENT LISTENERS
       ========================================================================== */
    function setupEventListeners() {
      // Core Mission Controls
      document.getElementById('startBtn').addEventListener('click', startSession);
      document.getElementById('pauseBtn').addEventListener('click', togglePause);
      document.getElementById('abortBtn').addEventListener('click', abortSession);
      document.getElementById('flushBtn').addEventListener('click', flushAndLogSession);

      // Reader Modal
      document.getElementById('closeReaderBtn').addEventListener('click', closeReaderModal);
      document.getElementById('openExternalSourceBtn').addEventListener('click', () => {
        window.open('https://news.google.com', '_blank', 'noopener,noreferrer');
      });

      // Refresh dispatches
      document.getElementById('refreshFeedBtn').addEventListener('click', () => {
        sound.playChime();
        loadDispatches(activeCategory);
      });

      // Topics Modal
      const topicsModal = document.getElementById('topicsModal');
      const customizeTopicsBtn = document.getElementById('customizeTopicsBtn');
      const closeTopicsBtn = document.getElementById('closeTopicsBtn');
      const saveTopicsBtn = document.getElementById('saveTopicsBtn');
      const addCustomCategoryBtn = document.getElementById('addCustomCategoryBtn');
      const customCategoryInput = document.getElementById('customCategoryInput');

      customizeTopicsBtn.addEventListener('click', () => {
        sound.playChime();
        renderTopicsCustomizer();
        topicsModal.classList.remove('hidden');
      });

      closeTopicsBtn.addEventListener('click', () => topicsModal.classList.add('hidden'));

      addCustomCategoryBtn.addEventListener('click', () => {
        const val = customCategoryInput.value.trim().toLowerCase().replace(/[^a-z0-9]/g, '');
        if (!val) return;
        if (!AppState.user.customCategories.includes(val)) {
          AppState.user.customCategories.push(val);
        }
        if (AppState.user.selectedTopics.length < 5 && !AppState.user.selectedTopics.includes(val)) {
          AppState.user.selectedTopics.push(val);
        }
        customCategoryInput.value = '';
        sound.playChime();
        renderTopicsCustomizer();
      });

      saveTopicsBtn.addEventListener('click', () => {
        const grid = document.getElementById('topicsGrid');
        const checked = Array.from(grid.querySelectorAll('.topic-checkbox:checked')).map(cb => cb.value);
        if (checked.length === 0) {
          alert("Select at least 1 reading category.");
          return;
        }
        AppState.user.selectedTopics = checked;
        saveState();
        renderCategoryTabs();
        loadDispatches(activeCategory);
        topicsModal.classList.add('hidden');
        sound.playChime();
      });

      // HIGH-VISIBILITY PROMINENT WAGE SELECTOR BUTTON
      const settingsModal = document.getElementById('settingsModal');
      const prominentWageBtn = document.getElementById('prominentWageBtn');
      const closeSettingsBtn = document.getElementById('closeSettingsBtn');
      const saveSettingsBtn = document.getElementById('saveSettingsBtn');
      const wageTypeHourly = document.getElementById('wageTypeHourly');
      const wageTypeSalary = document.getElementById('wageTypeSalary');
      const wageInput = document.getElementById('wageInput');
      const wageInputLabel = document.getElementById('wageInputLabel');
      const hoursPerWeekContainer = document.getElementById('hoursPerWeekContainer');
      const hoursPerWeekInput = document.getElementById('hoursPerWeekInput');
      const wageBreakdownHelper = document.getElementById('wageBreakdownHelper');

      let modalWageType = AppState.user.wageType;

      function updateWageModalDisplay() {
        if (modalWageType === 'hourly') {
          wageTypeHourly.className = 'py-2.5 px-3 rounded-xl border-2 border-amber-800 bg-amber-50 text-amber-900 font-bold text-sm';
          wageTypeSalary.className = 'py-2.5 px-3 rounded-xl border border-slate-200 bg-white text-slate-600 font-semibold text-sm';
          wageInputLabel.textContent = 'Hourly Rate (USD $)';
          hoursPerWeekContainer.classList.add('hidden');
          wageInput.value = AppState.user.hourlyRate;
          wageBreakdownHelper.textContent = `Generates approx $${((AppState.user.hourlyRate || 35) / 3600).toFixed(4)}/sec on company time.`;
        } else {
          wageTypeSalary.className = 'py-2.5 px-3 rounded-xl border-2 border-amber-800 bg-amber-50 text-amber-900 font-bold text-sm';
          wageTypeHourly.className = 'py-2.5 px-3 rounded-xl border border-slate-200 bg-white text-slate-600 font-semibold text-sm';
          wageInputLabel.textContent = 'Annual Salary (USD $)';
          hoursPerWeekContainer.classList.remove('hidden');
          wageInput.value = AppState.user.annualSalary;
          const weeklyHrs = AppState.user.hoursPerWeek || 40;
          const hourlyEquiv = AppState.user.annualSalary / (weeklyHrs * 52);
          wageBreakdownHelper.textContent = `Equates to approx $${hourlyEquiv.toFixed(2)}/hr ($${(hourlyEquiv / 3600).toFixed(4)}/sec).`;
        }
      }

      prominentWageBtn.addEventListener('click', () => {
        sound.playChime();
        modalWageType = AppState.user.wageType;
        hoursPerWeekInput.value = AppState.user.hoursPerWeek;
        updateWageModalDisplay();
        settingsModal.classList.remove('hidden');
      });

      closeSettingsBtn.addEventListener('click', () => settingsModal.classList.add('hidden'));

      wageTypeHourly.addEventListener('click', () => {
        modalWageType = 'hourly';
        updateWageModalDisplay();
      });

      wageTypeSalary.addEventListener('click', () => {
        modalWageType = 'salary';
        updateWageModalDisplay();
      });

      wageInput.addEventListener('input', () => {
        const val = parseFloat(wageInput.value) || 0;
        if (modalWageType === 'hourly') {
          wageBreakdownHelper.textContent = `Generates approx $${(val / 3600).toFixed(4)}/sec on company time.`;
        } else {
          const weeklyHrs = parseFloat(hoursPerWeekInput.value) || 40;
          const hourlyEquiv = val / (weeklyHrs * 52);
          wageBreakdownHelper.textContent = `Equates to approx $${hourlyEquiv.toFixed(2)}/hr ($${(hourlyEquiv / 3600).toFixed(4)}/sec).`;
        }
      });

      saveSettingsBtn.addEventListener('click', () => {
        sound.playChime();
        AppState.user.wageType = modalWageType;
        if (modalWageType === 'hourly') {
          AppState.user.hourlyRate = Math.max(1, parseFloat(wageInput.value) || 35);
        } else {
          AppState.user.annualSalary = Math.max(1000, parseFloat(wageInput.value) || 72800);
          AppState.user.hoursPerWeek = Math.max(1, parseFloat(hoursPerWeekInput.value) || 40);
        }
        saveState();
        updateRateBadges();
        settingsModal.classList.add('hidden');
      });

      // Profile Modal
      const profileModal = document.getElementById('profileModal');
      const profileBtn = document.getElementById('profileBtn');
      const closeProfileBtn = document.getElementById('closeProfileBtn');
      const saveProfileBtn = document.getElementById('saveProfileBtn');
      const randomizeNameBtn = document.getElementById('randomizeNameBtn');
      const throneNameInput = document.getElementById('throneNameInput');

      profileBtn.addEventListener('click', () => {
        sound.playChime();
        throneNameInput.value = AppState.user.throneName;
        profileModal.classList.remove('hidden');
      });

      closeProfileBtn.addEventListener('click', () => profileModal.classList.add('hidden'));

      randomizeNameBtn.addEventListener('click', () => {
        sound.playChime();
        throneNameInput.value = getRandomThroneName();
      });

      saveProfileBtn.addEventListener('click', () => {
        const val = throneNameInput.value.trim();
        if (val) {
          AppState.user.throneName = val;
          document.getElementById('navThroneName').textContent = val;
          saveState();
          sound.playChime();
          profileModal.classList.add('hidden');
        }
      });

      // Leaderboard sorting
      const sortEarningsBtn = document.getElementById('sortEarningsBtn');
      const sortPointsBtn = document.getElementById('sortPointsBtn');
      const sortRecentBtn = document.getElementById('sortRecentBtn');

      function updateSortButtons(activeBtn) {
        [sortEarningsBtn, sortPointsBtn, sortRecentBtn].forEach(b => {
          b.className = 'px-3 py-1 rounded-lg text-slate-500 hover:text-slate-800';
        });
        activeBtn.className = 'px-3 py-1 rounded-lg bg-white shadow-xs text-slate-800 font-bold';
      }

      sortEarningsBtn.addEventListener('click', () => {
        currentSortMode = 'earnings';
        updateSortButtons(sortEarningsBtn);
        renderHistoryAndStats();
      });

      sortPointsBtn.addEventListener('click', () => {
        currentSortMode = 'points';
        updateSortButtons(sortPointsBtn);
        renderHistoryAndStats();
      });

      sortRecentBtn.addEventListener('click', () => {
        currentSortMode = 'recent';
        updateSortButtons(sortRecentBtn);
        renderHistoryAndStats();
      });

      document.getElementById('clearDataBtn').addEventListener('click', () => {
        if (confirm("Reset all stored flushes and lifetime statistics? This cannot be undone.")) {
          AppState.sessions = [];
          saveState();
          renderHistoryAndStats();
        }
      });

      // Sponsor Modal
      const sponsorBtn = document.getElementById('sponsorBtn');
      const sponsorModal = document.getElementById('sponsorModal');
      const closeSponsorBtn = document.getElementById('closeSponsorBtn');
      const sendSponsorEmailBtn = document.getElementById('sendSponsorEmailBtn');

      sponsorBtn.addEventListener('click', () => {
        sound.playChime();
        sponsorModal.classList.remove('hidden');
      });
      closeSponsorBtn.addEventListener('click', () => sponsorModal.classList.add('hidden'));
      sendSponsorEmailBtn.addEventListener('click', () => {
        window.location.href = "mailto:sponsors@turdtally.internal?subject=Sponsoring%20The%20Throne%20Lounge&body=Hi%20TurdTally%20team,%20I'd%20like%20to%20sponsor%20captive%20high-income%20talent%20on%20company%20time!";
      });
    }

    /* ==========================================================================
       8. INITIALIZATION
       ========================================================================== */
    window.addEventListener('DOMContentLoaded', () => {
      loadState();
      document.getElementById('navThroneName').textContent = AppState.user.throneName;
      updateRateBadges();
      renderHistoryAndStats();
      setupEventListeners();
      renderCategoryTabs();
      loadDispatches(activeCategory);
    });
  </script>
</body>

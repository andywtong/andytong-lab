      AppState.sessions.forEach(s => {
        totalPay += (s.earnings || 0);
        totalSec += (s.durationSeconds || 0);
      });

      const avgPay = totalSessions > 0 ? (totalPay / totalSessions) : 0;
      const totalMinutes = Math.round(totalSec / 60);

      document.getElementById('statTotalPay').textContent = `$${totalPay.toFixed(2)}`;
      document.getElementById('statTotalFlushes').textContent = totalSessions;
      document.getElementById('statTotalTime').textContent = `${totalMinutes}m`;
      document.getElementById('statAvgValue').textContent = `$${avgPay.toFixed(2)}`;

      const rankBadge = document.getElementById('profileRankBadge');
      if (rankBadge) {
        if (totalSessions >= 25) rankBadge.textContent = 'Grand Porcelain Sovereign 👑';
        else if (totalSessions >= 10) rankBadge.textContent = 'Senior Wealth Reclamation Officer 🎖️';
        else if (totalSessions >= 3) rankBadge.textContent = 'Certified Throne Operator 🧻';
        else rankBadge.textContent = 'Junior Flush Officer 🚽';
      }

      const sorted = [...AppState.sessions];
      if (currentSortMode === 'earnings') {
        sorted.sort((a, b) => (b.earnings || 0) - (a.earnings || 0));
      } else if (currentSortMode === 'points') {
        sorted.sort((a, b) => (b.points || 0) - (a.points || 0));
      } else {
        sorted.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
      }

      const listContainer = document.getElementById('sessionHistoryList');
      if (!listContainer) return;

      if (sorted.length === 0) {
        listContainer.innerHTML = `
          <div class="text-center py-6 text-slate-400">
            <span class="text-2xl block mb-1">📭</span>
            <p class="text-xs">No flushes logged yet. Click Initiate Mission to begin reclaiming corporate pay!</p>
          </div>
        `;
        return;
      }

      listContainer.innerHTML = sorted.map((s, idx) => {
        const medal = idx === 0 ? '🥇' : idx === 1 ? '🥈' : idx === 2 ? '🥉' : `#${idx + 1}`;
        const dateStr = new Date(s.timestamp).toLocaleDateString(undefined, {
          month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'
        });

        const poopPts = s.poopPoints || Math.round((s.points || 0) * 0.7);
        const readPts = s.readingPoints || ((s.points || 0) - poopPts);

        return `
          <div class="flex items-center justify-between p-3 rounded-2xl bg-amber-50/50 hover:bg-amber-100/40 border border-amber-100/60 transition text-xs">
            <div class="flex items-center gap-2.5">
              <span class="font-display font-bold text-sm w-5 text-center text-amber-900">${medal}</span>
              <div>
                <span class="font-display font-semibold text-slate-800 text-sm block">${escapeHtml(s.throneName || 'ThroneWarrior')}</span>
                <span class="text-[10px] text-slate-400">${dateStr} • Duration: ${formatDurationClean(s.durationSeconds)}</span>
              </div>
            </div>
            <div class="text-right">
              <span class="font-mono font-bold text-emerald-600 text-sm block">+$${Number(s.earnings || 0).toFixed(2)}</span>
              <span class="font-mono text-[10px] text-slate-500 font-semibold block">
                <span class="text-amber-800">${poopPts} Stall</span> + <span class="text-emerald-700">${readPts} Read</span> = <strong class="text-amber-950">${s.points || 0} TP</strong>
              </span>
            </div>
          </div>
        `;
      }).join('');
    }

    function escapeHtml(str) {
      return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    /* ==========================================================================
       7. TOPIC CUSTOMIZATION ENGINE
       ========================================================================== */
    function renderTopicsCustomizer() {
      const grid = document.getElementById('topicsGrid');
      if (!grid) return;

      const allTopics = [...ALL_AVAILABLE_TOPICS];
      AppState.user.customCategories.forEach(c => {
        if (!allTopics.some(t => t.id === c)) {
          allTopics.push({ id: c, label: `🏷️ ${c.charAt(0).toUpperCase() + c.slice(1)}` });
        }
      });

      grid.innerHTML = allTopics.map(t => {
        const isChecked = AppState.user.selectedTopics.includes(t.id);
        return `
          <label class="flex items-center gap-2 p-2.5 rounded-xl border ${isChecked ? 'bg-amber-50 border-amber-300 font-bold text-amber-950' : 'bg-slate-50 border-slate-200 text-slate-600'} cursor-pointer transition">
            <input type="checkbox" value="${t.id}" class="topic-checkbox rounded text-amber-600 focus:ring-amber-500" ${isChecked ? 'checked' : ''}>
            <span class="truncate">${t.label}</span>
          </label>
        `;
      }).join('');

      document.getElementById('selectedTopicsCount').textContent = AppState.user.selectedTopics.length;

      grid.querySelectorAll('.topic-checkbox').forEach(box => {
        box.addEventListener('change', (e) => {
          const checked = Array.from(grid.querySelectorAll('.topic-checkbox:checked')).map(cb => cb.value);
          if (checked.length > 5) {
            e.target.checked = false;
            alert("Please pick a maximum of 5 favorite topics for the throne lounge bar.");
            return;
          }
          document.getElementById('selectedTopicsCount').textContent = checked.length;
        });
      });
    }

    /* ==========================================================================
       8. UI EVENT HANDLERS
       ========================================================================== */
    function setupEventListeners() {
      // Mission Controls: Initiate / Finished Mission
      document.getElementById('startBtn').addEventListener('click', toggleMission);
      document.getElementById('stickyToggleBtn').addEventListener('click', toggleMission);

      document.getElementById('pauseBtn').addEventListener('click', togglePause);
      document.getElementById('abortBtn').addEventListener('click', abortSession);
      document.getElementById('flushBtn').addEventListener('click', flushAndLogSession);

      // Reader Modal
      document.getElementById('closeReaderBtn').addEventListener('click', closeReaderModal);
      document.getElementById('openExternalSourceBtn').addEventListener('click', () => {
        if (AppState.reader.activeArticle && AppState.reader.activeArticle.externalUrl) {
          window.open(AppState.reader.activeArticle.externalUrl, '_blank', 'noopener,noreferrer');
        } else {
          window.open('https://news.google.com', '_blank', 'noopener,noreferrer');
        }
      });

      // Summary Modal Close
      document.getElementById('closeSummaryBtn').addEventListener('click', () => {
        document.getElementById('summaryModal').classList.add('hidden');
      });

      // Jump to Reading Lounge shortcuts
      const scrollToLounge = () => {
        const loungeEl = document.getElementById('readingLoungeSection');
        if (loungeEl) loungeEl.scrollIntoView({ behavior: 'smooth' });
      };
      document.getElementById('bannerToLoungeBtn').addEventListener('click', scrollToLounge);
      document.getElementById('jumpToLoungeBtn').addEventListener('click', scrollToLounge);

      // Refresh dispatches
      document.getElementById('refreshFeedBtn').addEventListener('click', () => {
        sound.playChime();
        loadDispatches(activeCategory);
      });

      // Topics Modal
      const topicsModal = document.getElementById('topicsModal');
      const customizeTopicsBtn = document.getElementById('customizeTopicsBtn');
      const closeTopicsBtn = document.getElementById('closeTopicsBtn');
      const saveTopicsBtn = document.getElementById('saveTopicsBtn');
      const addCustomCategoryBtn = document.getElementById('addCustomCategoryBtn');
      const customCategoryInput = document.getElementById('customCategoryInput');

      customizeTopicsBtn.addEventListener('click', () => {
        sound.playChime();
        renderTopicsCustomizer();
        topicsModal.classList.remove('hidden');
      });

      closeTopicsBtn.addEventListener('click', () => topicsModal.classList.add('hidden'));

      addCustomCategoryBtn.addEventListener('click', () => {
        const val = customCategoryInput.value.trim().toLowerCase().replace(/[^a-z0-9]/g, '');
        if (!val) return;
        if (!AppState.user.customCategories.includes(val)) {
          AppState.user.customCategories.push(val);
        }
        if (AppState.user.selectedTopics.length < 5 && !AppState.user.selectedTopics.includes(val)) {
          AppState.user.selectedTopics.push(val);
        }
        customCategoryInput.value = '';
        sound.playChime();
        renderTopicsCustomizer();
      });

      saveTopicsBtn.addEventListener('click', () => {
        const grid = document.getElementById('topicsGrid');
        const checked = Array.from(grid.querySelectorAll('.topic-checkbox:checked')).map(cb => cb.value);
        if (checked.length === 0) {
          alert("Select at least 1 reading category.");
          return;
        }
        AppState.user.selectedTopics = checked;
        saveState();
        renderCategoryTabs();
        loadDispatches(activeCategory);
        topicsModal.classList.add('hidden');
        sound.playChime();
      });

      // WAGE SETTINGS MODAL
      const settingsModal = document.getElementById('settingsModal');
      const prominentWageBtn = document.getElementById('prominentWageBtn');
      const closeSettingsBtn = document.getElementById('closeSettingsBtn');
      const saveSettingsBtn = document.getElementById('saveSettingsBtn');
      const wageTypeHourly = document.getElementById('wageTypeHourly');
      const wageTypeSalary = document.getElementById('wageTypeSalary');
      const wageInput = document.getElementById('wageInput');
      const wageInputLabel = document.getElementById('wageInputLabel');
      const hoursPerWeekContainer = document.getElementById('hoursPerWeekContainer');
      const hoursPerWeekInput = document.getElementById('hoursPerWeekInput');
      const wageBreakdownHelper = document.getElementById('wageBreakdownHelper');

      let modalWageType = AppState.user.wageType;

      function updateWageModalDisplay() {
        if (modalWageType === 'hourly') {
          wageTypeHourly.className = 'py-2.5 px-3 rounded-xl border-2 border-amber-800 bg-amber-50 text-amber-900 font-bold text-sm';
          wageTypeSalary.className = 'py-2.5 px-3 rounded-xl border border-slate-200 bg-white text-slate-600 font-semibold text-sm';
          wageInputLabel.textContent = 'Hourly Rate (USD $)';
          hoursPerWeekContainer.classList.add('hidden');
          wageInput.value = AppState.user.hourlyRate;
          wageBreakdownHelper.textContent = `Generates approx $${((AppState.user.hourlyRate || 35) / 3600).toFixed(4)}/sec on company time.`;
        } else {
          wageTypeSalary.className = 'py-2.5 px-3 rounded-xl border-2 border-amber-800 bg-amber-50 text-amber-900 font-bold text-sm';
          wageTypeHourly.className = 'py-2.5 px-3 rounded-xl border border-slate-200 bg-white text-slate-600 font-semibold text-sm';
          wageInputLabel.textContent = 'Annual Salary (USD $)';
          hoursPerWeekContainer.classList.remove('hidden');
          wageInput.value = AppState.user.annualSalary;
          const weeklyHrs = AppState.user.hoursPerWeek || 40;
          const hourlyEquiv = AppState.user.annualSalary / (weeklyHrs * 52);
          wageBreakdownHelper.textContent = `Equates to approx $${hourlyEquiv.toFixed(2)}/hr ($${(hourlyEquiv / 3600).toFixed(4)}/sec).`;
        }
      }

      prominentWageBtn.addEventListener('click', () => {
        sound.playChime();
        modalWageType = AppState.user.wageType;
        hoursPerWeekInput.value = AppState.user.hoursPerWeek;
        updateWageModalDisplay();
        settingsModal.classList.remove('hidden');
      });

      closeSettingsBtn.addEventListener('click', () => settingsModal.classList.add('hidden'));

      wageTypeHourly.addEventListener('click', () => {
        modalWageType = 'hourly';
        updateWageModalDisplay();
      });

      wageTypeSalary.addEventListener('click', () => {
        modalWageType = 'salary';
        updateWageModalDisplay();
      });

      wageInput.addEventListener('input', () => {
        const val = parseFloat(wageInput.value) || 0;
        if (modalWageType === 'hourly') {
          wageBreakdownHelper.textContent = `Generates approx $${(val / 3600).toFixed(4)}/sec on company time.`;
        } else {
          const weeklyHrs = parseFloat(hoursPerWeekInput.value) || 40;
          const hourlyEquiv = val / (weeklyHrs * 52);
          wageBreakdownHelper.textContent = `Equates to approx $${hourlyEquiv.toFixed(2)}/hr ($${(hourlyEquiv / 3600).toFixed(4)}/sec).`;
        }
      });

      saveSettingsBtn.addEventListener('click', () => {
        sound.playChime();
        AppState.user.wageType = modalWageType;
        if (modalWageType === 'hourly') {
          AppState.user.hourlyRate = Math.max(1, parseFloat(wageInput.value) || 35);
        } else {
          AppState.user.annualSalary = Math.max(1000, parseFloat(wageInput.value) || 72800);
          AppState.user.hoursPerWeek = Math.max(1, parseFloat(hoursPerWeekInput.value) || 40);
        }
        saveState();
        updateRateBadges();
        settingsModal.classList.add('hidden');
      });

      // Profile Modal
      const profileModal = document.getElementById('profileModal');
      const profileBtn = document.getElementById('profileBtn');
      const closeProfileBtn = document.getElementById('closeProfileBtn');
      const saveProfileBtn = document.getElementById('saveProfileBtn');
      const randomizeNameBtn = document.getElementById('randomizeNameBtn');
      const throneNameInput = document.getElementById('throneNameInput');

      profileBtn.addEventListener('click', () => {
        sound.playChime();
        throneNameInput.value = AppState.user.throneName;
        profileModal.classList.remove('hidden');
      });

      closeProfileBtn.addEventListener('click', () => profileModal.classList.add('hidden'));

      randomizeNameBtn.addEventListener('click', () => {
        sound.playChime();
        throneNameInput.value = getRandomThroneName();
      });

      saveProfileBtn.addEventListener('click', () => {
        const val = throneNameInput.value.trim();
        if (val) {
          AppState.user.throneName = val;
          document.getElementById('navThroneName').textContent = val;
          saveState();
          sound.playChime();
          profileModal.classList.add('hidden');
        }
      });

      // Leaderboard sorting
      const sortEarningsBtn = document.getElementById('sortEarningsBtn');
      const sortPointsBtn = document.getElementById('sortPointsBtn');
      const sortRecentBtn = document.getElementById('sortRecentBtn');

      function updateSortButtons(activeBtn) {
        [sortEarningsBtn, sortPointsBtn, sortRecentBtn].forEach(b => {
          b.className = 'px-2.5 py-1 rounded-lg text-slate-500 hover:text-slate-800';
        });
        activeBtn.className = 'px-2.5 py-1 rounded-lg bg-white shadow-xs text-slate-800 font-bold';
      }

      sortEarningsBtn.addEventListener('click', () => {
        currentSortMode = 'earnings';
        updateSortButtons(sortEarningsBtn);
        renderHistoryAndStats();
      });

      sortPointsBtn.addEventListener('click', () => {
        currentSortMode = 'points';
        updateSortButtons(sortPointsBtn);
        renderHistoryAndStats();
      });

      sortRecentBtn.addEventListener('click', () => {
        currentSortMode = 'recent';
        updateSortButtons(sortRecentBtn);
        renderHistoryAndStats();
      });

      document.getElementById('clearDataBtn').addEventListener('click', () => {
        if (confirm("Reset all stored flushes and lifetime statistics? This cannot be undone.")) {
          AppState.sessions = [];
          saveState();
          renderHistoryAndStats();
        }
      });

      // Sponsor Modal
      const sponsorBtn = document.getElementById('sponsorBtn');
      const sponsorModal = document.getElementById('sponsorModal');
      const closeSponsorBtn = document.getElementById('closeSponsorBtn');
      const sendSponsorEmailBtn = document.getElementById('sendSponsorEmailBtn');

      sponsorBtn.addEventListener('click', () => {
        sound.playChime();
        sponsorModal.classList.remove('hidden');
      });
      closeSponsorBtn.addEventListener('click', () => sponsorModal.classList.add('hidden'));
      sendSponsorEmailBtn.addEventListener('click', () => {
        window.location.href = "mailto:sponsors@turdtally.internal?subject=Sponsoring%20The%20Throne%20Lounge&body=Hi%20TurdTally%20team,%20I'd%20like%20to%20sponsor%20captive%20talent%20on%20company%20time!";
      });
    }

    /* ==========================================================================
       9. INITIALIZATION
       ========================================================================== */
    window.addEventListener('DOMContentLoaded', () => {
      loadState();
      document.getElementById('navThroneName').textContent = AppState.user.throneName;
      updateRateBadges();
      renderHistoryAndStats();
      setupEventListeners();
      renderCategoryTabs();
      loadDispatches(activeCategory);
      startPeerTicker();
    });
  </script>
</body>
</html>
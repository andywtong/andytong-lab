  <!-- ================= JAVASCRIPT APPLICATION CORE ================= -->
  <script>
    /* ----------------------------------------------------
       1. SECURITY & DATA INTEGRITY
    ---------------------------------------------------- */
    function escapeHTML(str) {
      if (typeof str !== 'string') return '';
      return str.replace(/[&<>'"]/g, function(tag) {
        return {
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          "'": '&#39;',
          '"': '&quot;'
        }[tag] || tag;
      });
    }

    function safeClampNumber(val, min, max, defaultVal) {
      const parsed = parseFloat(val);
      if (isNaN(parsed) || !isFinite(parsed)) return defaultVal;
      return Math.min(Math.max(parsed, min), max);
    }

    /* ----------------------------------------------------
       2. SYNTHESIZED WEB AUDIO (Zero External MP3s)
    ---------------------------------------------------- */
    let audioCtx = null;
    function getAudioContext() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (AudioContextClass) audioCtx = new AudioContextClass();
      }
      if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
      return audioCtx;
    }

    function playTone(freq, type, duration, gainLevel = 0.1) {
      try {
        const ctx = getAudioContext();
        if (!ctx) return;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, ctx.currentTime);
        gain.gain.setValueAtTime(gainLevel, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + duration);
      } catch (e) {}
    }

    function playFlushSound() {
      try {
        const ctx = getAudioContext();
        if (!ctx) return;
        const bufferSize = ctx.sampleRate * 2.0;
        const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
        
        const noise = ctx.createBufferSource();
        noise.buffer = buffer;
        const filter = ctx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(800, ctx.currentTime);
        filter.frequency.exponentialRampToValueAtTime(150, ctx.currentTime + 2.0);

        const gain = ctx.createGain();
        gain.gain.setValueAtTime(0.2, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 2.0);

        noise.connect(filter);
        filter.connect(gain);
        gain.connect(ctx.destination);
        noise.start();
      } catch (e) {}
    }

    /* ----------------------------------------------------
       3. APPLICATION STATE & PERSISTENCE
    ---------------------------------------------------- */
    const DEFAULT_TOPICS = [
      'Tech', 'Finance', 'Science', 'World News', 'History',
      'AI & Startups', 'Gaming', 'Sports', 'Pop Culture', 'Weird News'
    ];

    const state = {
      throneName: localStorage.getItem('tt_throne_name') || 'PlungerPat_' + Math.floor(100 + Math.random() * 900),
      hourlyWage: safeClampNumber(localStorage.getItem('tt_hourly_wage'), 1, 1000000, 45.00),
      wageMode: localStorage.getItem('tt_wage_mode') || 'hourly',

      // Mission State
      isActive: false,
      isPaused: false,
      secondsElapsed: 0,
      activeTimerInterval: null,

      // Points Breakdown
      poopPoints: 0,
      readingPoints: 0,

      // Reading Lounge
      activeCategory: 'Tech',
      favoriteCategories: JSON.parse(localStorage.getItem('tt_favorite_categories') || 'null') || ['Tech', 'Finance', 'Science', 'World News', 'History'],
      allCategories: JSON.parse(localStorage.getItem('tt_all_categories') || 'null') || [...DEFAULT_TOPICS],
      
      categoryArticles: {},
      isFetchingArticles: false,

      // Reader Modal
      activeReadingArticle: null,
      readerCountdownSeconds: 15,
      readerBonusInterval: null,

      // Lifetime History
      history: JSON.parse(localStorage.getItem('tt_history') || '[]'),
      lifetimeEarnings: safeClampNumber(localStorage.getItem('tt_lifetime_earnings'), 0, 10000000, 0),
      lifetimeSeconds: safeClampNumber(localStorage.getItem('tt_lifetime_seconds'), 0, 100000000, 0),
      lifetimePoints: safeClampNumber(localStorage.getItem('tt_lifetime_points'), 0, 10000000, 0),
      totalFlushes: safeClampNumber(localStorage.getItem('tt_total_flushes'), 0, 1000000, 0)
    };

    /* ----------------------------------------------------
       4. TRUE LIVE JOURNALISM API ENGINE (NO HARDCODED STORIES)
       - Uses Wikinews Open Journalism & MediaWiki Action API (CORS enabled, No Key)
       - Hacker News Algorithmic Engineering API
       - Zero synthetic fallback text: Real human-reported articles with actual sources
    ---------------------------------------------------- */
    
    // Category mapping for live Wikinews Category endpoints
    const CATEGORY_MAP = {
      'Tech': 'Technology_and_the_Internet',
      'Finance': 'Economy_and_business',
      'Science': 'Science_and_technology',
      'World News': 'Politics_and_conflicts',
      'History': 'Obituaries_and_memorials',
      'AI & Startups': 'Technology_and_the_Internet',
      'Gaming': 'Video_games',
      'Sports': 'Sports',
      'Pop Culture': 'Culture_and_entertainment',
      'Weird News': 'Oddities'
    };

    // Tracks pagination/refresh offsets to ensure DIFFERENT stories load on each click
    const categoryOffsets = {};

    async function fetchFullArticleText(pageId) {
      try {
        const res = await fetch(`https://en.wikinews.org/w/api.php?action=query&prop=extracts&pageids=${pageId}&explaintext=1&format=json&origin=*`);
        if (!res.ok) return null;
        const data = await res.json();
        const page = data?.query?.pages?.[pageId];
        if (!page || !page.extract) return null;

        // Split text by paragraphs and filter out navigational wikinews headers
        const rawParas = page.extract.split('\n');
        const cleanParas = rawParas
          .map(p => p.trim())
          .filter(p => p.length > 50 && !p.startsWith('==') && !p.includes('Have an opinion') && !p.includes('Share this:'));

        return cleanParas.length >= 2 ? cleanParas : null;
      } catch (err) {
        return null;
      }
    }

    async function loadCategoryArticles(category, forceRefresh = false) {
      if (!categoryOffsets[category]) categoryOffsets[category] = 0;
      if (forceRefresh) {
        categoryOffsets[category] = (categoryOffsets[category] + 3) % 45;
      }

      state.isFetchingArticles = true;
      const grid = document.getElementById('articlesGrid');
      const loading = document.getElementById('articlesLoading');
      grid.innerHTML = '';
      loading.classList.remove('hidden');

      let articles = [];
      const wikiCategory = CATEGORY_MAP[category] || 'Published';
      const offset = categoryOffsets[category];

      try {
        // Query live articles from human reporters on Wikinews
        const listUrl = `https://en.wikinews.org/w/api.php?action=query&list=categorymembers&cmtitle=Category:${wikiCategory}&cmlimit=12&cmnamespace=0&cmsort=timestamp&cmdir=desc&format=json&origin=*`;
        const listRes = await fetch(listUrl);
        
        if (listRes.ok) {
          const listData = await listRes.json();
          const members = listData?.query?.categorymembers || [];

          // Shift through the members using the dynamic offset so it changes on every refresh
          const candidates = [...members.slice(offset), ...members.slice(0, offset)];

          for (const member of candidates) {
            if (articles.length >= 3) break;
            const paragraphs = await fetchFullArticleText(member.pageid);
            if (paragraphs && paragraphs.length >= 2) {
              articles.push({
                id: `wn_${member.pageid}_${Date.now()}_${articles.length}`,
                category: category,
                title: member.title,
                author: 'Wikinews Staff Reporter & Field Correspondents',
                sourceOrg: 'Wikinews Open Press Bureau',
                sourceUrl: `https://en.wikinews.org/wiki/${encodeURIComponent(member.title.replace(/ /g, '_'))}`,
                isAi: false,
                readTime: `${Math.max(3, Math.ceil(paragraphs.join(' ').split(' ').length / 180))} min read`,
                timestamp: 'Verified Live Human Report',
                summary: paragraphs[0].substring(0, 200) + '...',
                body: paragraphs
              });
            }
          }
        }

        // Secondary fallback to live Wikipedia Current Knowledge Engine if category had few recent updates
        if (articles.length < 3) {
          const wikiSearchOffset = (offset + Math.floor(Math.random() * 5));
          const searchRes = await fetch(`https://en.wikipedia.org/w/api.php?action=query&generator=search&gsrsearch=${encodeURIComponent(category)}&gsrlimit=6&gsroffset=${wikiSearchOffset}&prop=extracts&explaintext=1&exchars=3500&format=json&origin=*`);
          if (searchRes.ok) {
            const searchData = await searchRes.json();
            const pages = Object.values(searchData?.query?.pages || {});
            for (const pg of pages) {
              if (articles.length >= 3) break;
              if (pg.extract && pg.extract.length > 350) {
                const paras = pg.extract.split('\n').map(p => p.trim()).filter(p => p.length > 60 && !p.startsWith('=='));
                if (paras.length >= 2) {
                  articles.push({
                    id: `wiki_${pg.pageid}_${Date.now()}`,
                    category: category,
                    title: pg.title,
                    author: 'Wikimedia Verified Research Contributors',
                    sourceOrg: 'Wikimedia Open Archives',
                    sourceUrl: `https://en.wikipedia.org/?curid=${pg.pageid}`,
                    isAi: false,
                    readTime: '4 min complete read',
                    timestamp: 'Public Record',
                    summary: paras[0].substring(0, 190) + '...',
                    body: paras
                  });
                }
              }
            }
          }
        }
      } catch (err) {
        console.error('Live article fetch error:', err);
      }

      state.categoryArticles[category] = articles.slice(0, 3);
      state.isFetchingArticles = false;
      loading.classList.add('hidden');
      renderArticles(state.categoryArticles[category]);
    }

    function renderArticles(articles) {
      const grid = document.getElementById('articlesGrid');
      grid.innerHTML = '';

      if (!articles || articles.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full py-8 text-center text-slate-400 font-mono text-xs">
            Unable to connect to live open press wire. Click "Refresh Stories" to retry.
          </div>
        `;
        return;
      }

      articles.forEach(art => {
        const card = document.createElement('div');
        card.className = 'bg-slate-900/90 hover:bg-slate-800/80 border border-slate-800 hover:border-amber-500/40 rounded-2xl p-5 flex flex-col justify-between transition-all duration-200 shadow-md group cursor-pointer';
        card.onclick = () => openReaderModal(art);

        card.innerHTML = `
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20">${escapeHTML(art.category)}</span>
              <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/30">✓ Human-Reported</span>
            </div>
            <h4 class="font-display font-bold text-sm text-white group-hover:text-amber-300 transition-colors line-clamp-2 mb-2 leading-snug">
              ${escapeHTML(art.title)}
            </h4>
            <p class="text-xs text-slate-400 line-clamp-3 leading-relaxed mb-4">
              ${escapeHTML(art.summary)}
            </p>
          </div>

          <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs">
            <div class="truncate max-w-[160px]">
              <span class="text-[11px] font-mono text-slate-300 block truncate font-medium">${escapeHTML(art.author)}</span>
              <span class="text-[10px] text-slate-500 block truncate">${escapeHTML(art.sourceOrg)}</span>
            </div>
            <span class="text-amber-400 font-bold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 shrink-0">
              Read Entire Report &rarr;
            </span>
          </div>
        `;
        grid.appendChild(card);
      });
    }

    function refreshCategoryStories() {
      playTone(440, 'sine', 0.1, 0.05);
      const icon = document.getElementById('refreshIcon');
      if (icon) {
        icon.classList.add('animate-spin');
        setTimeout(() => icon.classList.remove('animate-spin'), 600);
      }
      loadCategoryArticles(state.activeCategory, true);
    }

    /* ----------------------------------------------------
       5. UNABRIDGED IN-APP READING MODAL WITH ATTRIBUTION
    ---------------------------------------------------- */
    function updateReaderCountdownUI() {
      const countdownEl = document.getElementById('readerCountdown');
      const trackerEl = document.getElementById('readerBonusTracker');
      if (!countdownEl || !trackerEl) return;

      if (!state.isActive) {
        countdownEl.textContent = 'Standby';
        trackerEl.title = 'Initiate a mission to earn reading TurdPoints';
      } else {
        countdownEl.textContent = `${state.readerCountdownSeconds}s`;
      }
    }

    function readerTick() {
      if (!state.isActive || state.isPaused) {
        updateReaderCountdownUI();
        return;
      }

      state.readerCountdownSeconds--;
      if (state.readerCountdownSeconds <= 0) {
        state.readingPoints += 10;
        state.readerCountdownSeconds = 15;
        playTone(880, 'sine', 0.2, 0.12);
        updateMainDisplays();
      }
      updateReaderCountdownUI();
    }

    function openReaderModal(article) {
      state.activeReadingArticle = article;
      state.readerCountdownSeconds = 15;

      document.getElementById('readerCategoryBadge').textContent = article.category;
      document.getElementById('readerTitle').textContent = article.title;
      document.getElementById('readerAuthor').textContent = `By ${article.author}`;
      document.getElementById('readerSourceOrg').textContent = article.sourceOrg;
      document.getElementById('readerReadTime').textContent = article.readTime;
      document.getElementById('readerTimestamp').textContent = article.timestamp;

      // Link to original news record
      const linkEl = document.getElementById('readerExternalLink');
      linkEl.href = article.sourceUrl || '#';
      linkEl.textContent = `${article.sourceOrg} — ${article.sourceUrl || 'Public Archive'}`;

      // Full body paragraphs
      const bodyContainer = document.getElementById('readerBodyText');
      bodyContainer.innerHTML = '';
      article.body.forEach(para => {
        const p = document.createElement('p');
        p.className = 'leading-relaxed text-slate-200';
        p.textContent = para;
        bodyContainer.appendChild(p);
      });

      updateReaderCountdownUI();
      document.getElementById('readerModal').classList.remove('hidden');

      if (state.readerBonusInterval) clearInterval(state.readerBonusInterval);
      state.readerBonusInterval = setInterval(readerTick, 1000);
    }

    function closeReaderModal() {
      const modal = document.getElementById('readerModal');
      if (modal) modal.classList.add('hidden');
      state.activeReadingArticle = null;
      if (state.readerBonusInterval) {
        clearInterval(state.readerBonusInterval);
        state.readerBonusInterval = null;
      }
    }

    // Attach to global window scope
    window.openReaderModal = openReaderModal;
    window.closeReaderModal = closeReaderModal;
    window.refreshCategoryStories = refreshCategoryStories;

    /* ----------------------------------------------------
       6. WAGE, CATEGORIES, MODALS & CORE INIT
    ---------------------------------------------------- */
    function openWageModal() {
      const modal = document.getElementById('wageModal');
      if (modal) modal.classList.remove('hidden');
      const input = document.getElementById('inputWageAmount');
      if (input) input.value = state.hourlyWage.toFixed(2);
      updateWagePreview();
    }

    function closeWageModal() {
      const modal = document.getElementById('wageModal');
      if (modal) modal.classList.add('hidden');
    }

    function setWageCalculationMode(mode) {
      state.wageMode = mode;
      const hourlyBtn = document.getElementById('calcModeHourly');
      const salaryBtn = document.getElementById('calcModeSalary');
      const label = document.getElementById('wageInputLabel');
      const input = document.getElementById('inputWageAmount');

      if (mode === 'hourly') {
        if (hourlyBtn) hourlyBtn.className = 'py-1.5 text-xs font-bold rounded-lg bg-amber-500 text-slate-950 transition';
        if (salaryBtn) salaryBtn.className = 'py-1.5 text-xs font-bold rounded-lg text-slate-400 hover:text-white transition';
        if (label) label.textContent = 'Hourly Rate ($)';
        if (input) input.value = state.hourlyWage.toFixed(2);
      } else {
        if (salaryBtn) salaryBtn.className = 'py-1.5 text-xs font-bold rounded-lg bg-amber-500 text-slate-950 transition';
        if (hourlyBtn) hourlyBtn.className = 'py-1.5 text-xs font-bold rounded-lg text-slate-400 hover:text-white transition';
        if (label) label.textContent = 'Annual Salary ($) (2,080 hrs/yr)';
        if (input) input.value = (state.hourlyWage * 2080).toFixed(0);
      }
      updateWagePreview();
    }

    function updateWagePreview() {
      const input = document.getElementById('inputWageAmount');
      const rawVal = input ? (parseFloat(input.value) || 0) : 0;
      let computedHourly = rawVal;
      if (state.wageMode === 'salary') computedHourly = rawVal / 2080;
      const perSec = computedHourly / 3600;
      const fifteenMin = perSec * 900;

      const pSec = document.getElementById('previewPerSecond');
      const p15 = document.getElementById('previewFifteenMin');
      if (pSec) pSec.textContent = '$' + perSec.toFixed(4);
      if (p15) p15.textContent = '$' + fifteenMin.toFixed(2);
    }

    function saveWageSettings() {
      const input = document.getElementById('inputWageAmount');
      const rawVal = input ? (parseFloat(input.value) || 0) : 0;
      let finalHourly = rawVal;
      if (state.wageMode === 'salary') finalHourly = rawVal / 2080;
      state.hourlyWage = safeClampNumber(finalHourly, 1.00, 1000000.00, 45.00);
      localStorage.setItem('tt_hourly_wage', state.hourlyWage);
      localStorage.setItem('tt_wage_mode', state.wageMode);
      closeWageModal();
      updateMainDisplays();
    }

    function promptChangeThroneName() {
      const entered = prompt('Enter your custom Throne Moniker (max 20 chars):', state.throneName);
      if (entered !== null) {
        const clean = entered.trim().substring(0, 20);
        if (clean.length > 0) {
          state.throneName = clean;
          localStorage.setItem('tt_throne_name', clean);
          updateMainDisplays();
        }
      }
    }

    function openCategoryCustomizerModal() {
      const container = document.getElementById('categoryToggleList');
      if (!container) return;
      container.innerHTML = '';

      state.allCategories.forEach(cat => {
        const isFav = state.favoriteCategories.includes(cat);
        const row = document.createElement('div');
        row.className = 'flex items-center justify-between p-2 rounded-xl bg-slate-900 border border-slate-800 text-xs';
        row.innerHTML = `
          <span class="font-semibold text-slate-200">${escapeHTML(cat)}</span>
          <button onclick="toggleFavoriteCategory('${escapeHTML(cat)}')" class="px-2.5 py-1 rounded text-[11px] font-bold ${
            isFav ? 'bg-amber-500 text-slate-950' : 'bg-slate-800 text-slate-400 hover:text-white'
          }">
            ${isFav ? '✓ Pinned' : '+ Pin'}
          </button>
        `;
        container.appendChild(row);
      });

      const modal = document.getElementById('categoryModal');
      if (modal) modal.classList.remove('hidden');
    }

    function closeCategoryCustomizerModal() {
      const modal = document.getElementById('categoryModal');
      if (modal) modal.classList.add('hidden');
      renderCategoryTabs();
    }

    function toggleFavoriteCategory(cat) {
      const idx = state.favoriteCategories.indexOf(cat);
      if (idx >= 0) {
        if (state.favoriteCategories.length > 1) {
          state.favoriteCategories.splice(idx, 1);
        } else {
          return;
        }
      } else {
        if (state.favoriteCategories.length >= 5) state.favoriteCategories.shift();
        state.favoriteCategories.push(cat);
      }
      localStorage.setItem('tt_favorite_categories', JSON.stringify(state.favoriteCategories));
      openCategoryCustomizerModal();
    }

    function addCustomCategory() {
      const input = document.getElementById('customTopicInput');
      if (!input) return;
      const val = input.value.trim();
      if (!val) return;
      if (!state.allCategories.includes(val)) {
        state.allCategories.push(val);
        localStorage.setItem('tt_all_categories', JSON.stringify(state.allCategories));
        if (state.favoriteCategories.length < 5) {
          state.favoriteCategories.push(val);
          localStorage.setItem('tt_favorite_categories', JSON.stringify(state.favoriteCategories));
        }
      }
      input.value = '';
      openCategoryCustomizerModal();
    }

    function renderCategoryTabs() {
      const container = document.getElementById('categoryTabBar');
      if (!container) return;
      container.innerHTML = '';

      state.favoriteCategories.slice(0, 5).forEach(cat => {
        const isActive = (cat === state.activeCategory);
        const btn = document.createElement('button');
        btn.onclick = () => selectCategory(cat);
        btn.className = isActive
          ? 'px-4 py-2 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 transition whitespace-nowrap shadow-md'
          : 'px-4 py-2 rounded-xl text-xs font-semibold bg-slate-900 hover:bg-slate-800 text-slate-300 transition whitespace-nowrap border border-slate-800';
        btn.textContent = escapeHTML(cat);
        container.appendChild(btn);
      });
    }

    function selectCategory(category) {
      state.activeCategory = category;
      renderCategoryTabs();
      loadCategoryArticles(category, false);
    }

    function scrollToReadingLounge() {
      const lounge = document.getElementById('readingLoungeSection');
      if (lounge) lounge.scrollIntoView({ behavior: 'smooth' });
    }

    function closeFlushModal() {
      const modal = document.getElementById('flushModal');
      if (modal) modal.classList.add('hidden');
    }

    // Bind all handlers to window
    window.openWageModal = openWageModal;
    window.closeWageModal = closeWageModal;
    window.setWageCalculationMode = setWageCalculationMode;
    window.saveWageSettings = saveWageSettings;
    window.promptChangeThroneName = promptChangeThroneName;
    window.openCategoryCustomizerModal = openCategoryCustomizerModal;
    window.closeCategoryCustomizerModal = closeCategoryCustomizerModal;
    window.toggleFavoriteCategory = toggleFavoriteCategory;
    window.addCustomCategory = addCustomCategory;
    window.selectCategory = selectCategory;
    window.scrollToReadingLounge = scrollToReadingLounge;
    window.closeFlushModal = closeFlushModal;

    // Wage input live listener
    const wageInputEl = document.getElementById('inputWageAmount');
    if (wageInputEl) {
      wageInputEl.addEventListener('input', updateWagePreview);
    }

    /* ----------------------------------------------------
       7. MISSION CONTROL TICKER & HISTORY
    ---------------------------------------------------- */
    function formatTime(totalSeconds) {
      const hrs = Math.floor(totalSeconds / 3600);
      const mins = Math.floor((totalSeconds % 3600) / 60);
      const secs = totalSeconds % 60;
      return [
        hrs.toString().padStart(2, '0'),
        mins.toString().padStart(2, '0'),
        secs.toString().padStart(2, '0')
      ].join(':');
    }

    function calculateEarnedDollars(seconds) {
      const perSecondRate = state.hourlyWage / 3600;
      return (seconds * perSecondRate).toFixed(3);
    }

    function updateMainDisplays() {
      const timeStr = formatTime(state.secondsElapsed);
      const earnedStr = '$' + calculateEarnedDollars(state.secondsElapsed);
      const totalPoints = state.poopPoints + state.readingPoints;

      // Primary Tracker
      document.getElementById('mainTimerDisplay').textContent = timeStr;
      document.getElementById('mainEarnedDisplay').textContent = earnedStr;
      document.getElementById('mainPointsDisplay').textContent = totalPoints;
      document.getElementById('subPoopPoints').textContent = state.poopPoints;
      document.getElementById('subReadingPoints').textContent = state.readingPoints;

      // Sticky HUD
      document.getElementById('hudTimer').textContent = timeStr;
      document.getElementById('hudEarned').textContent = earnedStr;
      document.getElementById('hudPoints').textContent = totalPoints;

      // Wage Banner & Profile
      document.getElementById('bannerWageDisplay').textContent = '$' + state.hourlyWage.toFixed(2);
      const perSec = (state.hourlyWage / 3600).toFixed(4);
      document.getElementById('bannerPerSecondDisplay').textContent = '$' + perSec;
      document.getElementById('displayThroneName').textContent = state.throneName;

      // Top HUD button toggle
      const hudBtn = document.getElementById('hudActionBtn');
      if (state.isActive) {
        hudBtn.textContent = 'Finished Mission';
        hudBtn.className = 'bg-emerald-500 hover:bg-emerald-400 active:scale-95 text-slate-950 font-display font-bold text-sm px-4 py-1.5 rounded-xl transition-all shadow-md';
      } else {
        hudBtn.textContent = 'Initiate Mission';
        hudBtn.className = 'bg-amber-500 hover:bg-amber-400 active:scale-95 text-slate-950 font-display font-bold text-sm px-4 py-1.5 rounded-xl transition-all shadow-md';
      }
    }

    function missionTick() {
      if (!state.isActive || state.isPaused) return;
      state.secondsElapsed++;
      if (state.secondsElapsed % 5 === 0) {
        state.poopPoints += 1;
      }
      updateMainDisplays();
    }

    function toggleMissionPrimary() {
      if (!state.isActive) {
        startMission();
      } else {
        flushAndLogSession();
      }
    }

    function startMission() {
      if (state.isActive) return;
      state.isActive = true;
      state.isPaused = false;
      state.secondsElapsed = 0;
      state.poopPoints = 0;
      state.readingPoints = 0;

      document.getElementById('btnStart').disabled = true;
      document.getElementById('btnStart').classList.add('opacity-40', 'pointer-events-none');
      document.getElementById('btnPause').disabled = false;
      document.getElementById('btnAbort').disabled = false;
      document.getElementById('btnFlush').disabled = false;

      const pill = document.getElementById('sessionStatusPill');
      pill.textContent = 'Mission In Progress';
      pill.className = 'mt-2 inline-block text-[10px] uppercase font-bold tracking-widest text-emerald-400 bg-emerald-950/80 border border-emerald-500/40 px-2.5 py-0.5 rounded-full mx-auto animate-pulse';

      playTone(523.25, 'sine', 0.15, 0.1);
      setTimeout(() => playTone(659.25, 'sine', 0.25, 0.15), 150);

      if (state.activeTimerInterval) clearInterval(state.activeTimerInterval);
      state.activeTimerInterval = setInterval(missionTick, 1000);
      updateMainDisplays();
    }

    function pauseMission() {
      if (!state.isActive) return;
      state.isPaused = !state.isPaused;
      const pauseLabel = document.getElementById('pauseBtnLabel');
      const pill = document.getElementById('sessionStatusPill');

      if (state.isPaused) {
        pauseLabel.textContent = '▶️ Resume';
        pill.textContent = 'Paused (Holding It)';
        pill.className = 'mt-2 inline-block text-[10px] uppercase font-bold tracking-widest text-amber-400 bg-amber-950/80 border border-amber-500/40 px-2.5 py-0.5 rounded-full mx-auto';
        playTone(392.00, 'triangle', 0.15, 0.1);
      } else {
        pauseLabel.textContent = '⏸️ Hold It';
        pill.textContent = 'Mission In Progress';
        pill.className = 'mt-2 inline-block text-[10px] uppercase font-bold tracking-widest text-emerald-400 bg-emerald-950/80 border border-emerald-500/40 px-2.5 py-0.5 rounded-full mx-auto animate-pulse';
        playTone(523.25, 'triangle', 0.15, 0.1);
      }
    }

    function abortMission() {
      if (!confirm('Are you sure you want to abort? No earnings or points will be recorded.')) return;
      resetMissionState();
      playTone(220, 'sawtooth', 0.3, 0.15);
    }

    function resetMissionState() {
      state.isActive = false;
      state.isPaused = false;
      if (state.activeTimerInterval) clearInterval(state.activeTimerInterval);
      state.activeTimerInterval = null;

      state.secondsElapsed = 0;
      state.poopPoints = 0;
      state.readingPoints = 0;

      document.getElementById('btnStart').disabled = false;
      document.getElementById('btnStart').classList.remove('opacity-40', 'pointer-events-none');
      document.getElementById('btnPause').disabled = true;
      document.getElementById('btnAbort').disabled = true;
      document.getElementById('btnFlush').disabled = true;
      document.getElementById('pauseBtnLabel').textContent = '⏸️ Hold It';

      const pill = document.getElementById('sessionStatusPill');
      pill.textContent = 'Standby';
      pill.className = 'mt-2 inline-block text-[10px] uppercase font-bold tracking-widest text-slate-500 bg-slate-800 px-2 py-0.5 rounded-full mx-auto';

      updateMainDisplays();
    }

    function flushAndLogSession() {
      if (!state.isActive) return;

      const durationStr = formatTime(state.secondsElapsed);
      const earnedAmount = parseFloat(calculateEarnedDollars(state.secondsElapsed));
      const totalSessionPoints = state.poopPoints + state.readingPoints;

      playFlushSound();

      state.lifetimeEarnings += earnedAmount;
      state.lifetimeSeconds += state.secondsElapsed;
      state.lifetimePoints += totalSessionPoints;
      state.totalFlushes += 1;

      const newEntry = {
        id: 'flush_' + Date.now(),
        date: new Date().toLocaleDateString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }),
        duration: durationStr,
        earned: earnedAmount.toFixed(2),
        poopPoints: state.poopPoints,
        readingPoints: state.readingPoints,
        totalPoints: totalSessionPoints
      };
      state.history.unshift(newEntry);
      if (state.history.length > 25) state.history.pop();

      localStorage.setItem('tt_lifetime_earnings', state.lifetimeEarnings);
      localStorage.setItem('tt_lifetime_seconds', state.lifetimeSeconds);
      localStorage.setItem('tt_lifetime_points', state.lifetimePoints);
      localStorage.setItem('tt_total_flushes', state.totalFlushes);
      localStorage.setItem('tt_history', JSON.stringify(state.history));

      document.getElementById('summaryDuration').textContent = durationStr;
      document.getElementById('summaryEarnings').textContent = '$' + earnedAmount.toFixed(2);
      document.getElementById('summaryPoopPoints').textContent = state.poopPoints;
      document.getElementById('summaryReadingPoints').textContent = state.readingPoints;
      document.getElementById('summaryTotalPoints').textContent = totalSessionPoints;
      document.getElementById('flushModal').classList.remove('hidden');

      closeReaderModal();
      resetMissionState();
      renderHistoryAndStats();
    }

    function renderHistoryAndStats() {
      document.getElementById('statCareerEarnings').textContent = '$' + state.lifetimeEarnings.toFixed(2);
      const hours = Math.floor(state.lifetimeSeconds / 3600);
      const mins = Math.floor((state.lifetimeSeconds % 3600) / 60);
      document.getElementById('statCareerTime').textContent = `${hours}h ${mins}m`;
      document.getElementById('statCareerPoints').textContent = state.lifetimePoints;
      document.getElementById('statTotalFlushes').textContent = state.totalFlushes;

      const tbody = document.getElementById('historyTableBody');
      tbody.innerHTML = '';

      if (state.history.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" class="py-6 text-center text-slate-500 italic">No flush missions logged yet. Initiate your first session above!</td>
          </tr>
        `;
        return;
      }

      state.history.forEach(item => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-800/40 transition';
        tr.innerHTML = `
          <td class="py-2 px-3 text-slate-400">${escapeHTML(item.date)}</td>
          <td class="py-2 px-3 font-bold text-white">${escapeHTML(item.duration)}</td>
          <td class="py-2 px-3 text-emerald-400 font-bold">$${escapeHTML(item.earned)}</td>
          <td class="py-2 px-3 text-slate-400">
            <span class="text-slate-300">${item.poopPoints || 0}</span> / 
            <span class="text-amber-300 font-semibold">${item.readingPoints || 0}</span>
          </td>
          <td class="py-2 px-3 text-amber-400 font-extrabold">${item.totalPoints || 0}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function clearSessionHistory() {
      if (!confirm('Clear your local history log? Lifetime summary tallies will remain.')) return;
      state.history = [];
      localStorage.removeItem('tt_history');
      renderHistoryAndStats();
    }

    window.startMission = startMission;
    window.pauseMission = pauseMission;
    window.abortMission = abortMission;
    window.flushAndLogSession = flushAndLogSession;
    window.toggleMissionPrimary = toggleMissionPrimary;
    window.clearSessionHistory = clearSessionHistory;

    /* ----------------------------------------------------
       8. TELEMETRY TICKER & INIT
    ---------------------------------------------------- */
    const LOCAL_TICKER_MSGS = [
      "🚽 Taking a 15-minute daily throne break earns you 65 hours of paid leisure per year.",
      "💡 Read live dispatches in the Throne Reading Lounge to earn +10 TurdPoints every 15s.",
      "👑 Customize your Throne Moniker anytime from your profile bar.",
      "💼 Reclaiming corporate capital: Every cent counted is a victory for workforce balance.",
      "📖 Live journalism feeds update dynamically. Click 'Refresh Stories' anytime for fresh dispatches."
    ];
    let tickerIndex = 0;
    setInterval(() => {
      const el = document.getElementById('telemetryTicker');
      if (!el) return;
      tickerIndex = (tickerIndex + 1) % LOCAL_TICKER_MSGS.length;
      el.textContent = LOCAL_TICKER_MSGS[tickerIndex];
    }, 7000);

    window.addEventListener('DOMContentLoaded', () => {
      renderCategoryTabs();
      loadCategoryArticles(state.activeCategory, false);
      renderHistoryAndStats();
      updateMainDisplays();
    });
  </script>
</body>
</html>
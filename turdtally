      clearInterval(tickerInterval);
      clearInterval(readingBonusInterval);
      tickerInterval = setInterval(tick, 100);
      readingBonusInterval = setInterval(readingTick, 1000);
    }

    function togglePause() {
      if (!AppState.currentSession.active) return;
      sound.playChime();
      AppState.currentSession.paused = !AppState.currentSession.paused;

      const pauseIcon = document.getElementById('pauseBtnIcon');
      const pauseText = document.getElementById('pauseBtnText');

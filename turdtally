    };

    // RSS Feed Endpoints mapped to CORS parsers
    const RSS_FEEDS = {
      tech: 'https://news.ycombinator.com/rss',
      finance: 'https://feeds.content.dowjones.io/public/rss/mw_topstories',
      science: 'https://www.sciencedaily.com/rss/top/science.xml',
      weird: 'https://www.upi.com/rss/Odd_News/',
      history: 'https://www.historytoday.com/feed/rss.xml'
    };

    let activeCategory = 'tech';

    // Safe Link Interceptor to cleanly bypass sandboxed iframe restrictions
    window.safeOpenLink = function(url) {
      if (!url) return;
      try {
        const opened = window.open(url, '_blank', 'noopener,noreferrer');
        if (!opened || opened.closed || typeof opened.closed === 'undefined') {
          // If popup blocked, create anchor and click
          const a = document.createElement('a');
          a.href = url;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
        }
      } catch (e) {
        console.warn('Navigation fallback:', e);
        window.location.href = url;
      }
    };

    async function fetchNewsForCategory(category) {
      const container = document.getElementById('newsFeedList');
      if (!container) return;

      container.innerHTML = `
        <div class="text-center py-10 text-slate-400">
          <div class="inline-block animate-spin text-2xl mb-2">🌀</div>
          <p class="text-xs">Fetching latest ${category.toUpperCase()} dispatches...</p>
        </div>
      `;

      try {
        const feedUrl = RSS_FEEDS[category];
        // Use rss2json free parser with timeout fallback
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 4000);

        const res = await fetch(`https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(feedUrl)}`, {
          signal: controller.signal
        });
        clearTimeout(timeoutId);

        if (!res.ok) throw new Error('Network failed');
        const data = await res.json();

        if (data && data.items && data.items.length > 0) {
          renderArticles(data.items.slice(0, 6).map(item => ({
            title: item.title,
            source: data.feed.title || 'Live Feed',
            time: 'Fresh',
            url: item.link,
            snippet: (item.description || '').replace(/<[^>]*>?/gm, '').slice(0, 140) + '...'
          })));
          return;
        }
        throw new Error('No items returned');
      } catch (err) {
        // Fallback gracefully to curated informative items
        console.log('Serving offline curated lounge feed for', category);
        const fallbackList = FALLBACK_FEEDS[category] || FALLBACK_FEEDS.tech;
        renderArticles(fallbackList);
      }
    }

    function renderArticles(articles) {
      const container = document.getElementById('newsFeedList');
      if (!container) return;

      container.innerHTML = articles.map(art => `
        <div class="p-3.5 rounded-2xl bg-slate-50 hover:bg-amber-50/60 border border-slate-200/70 hover:border-amber-200 transition group cursor-pointer" onclick="safeOpenLink('${encodeURI(art.url)}')">
          <div class="flex items-center justify-between text-[11px] text-slate-400 mb-1">
            <span class="font-bold text-amber-800">${escapeHtml(art.source)}</span>
            <span>${escapeHtml(art.time)}</span>
          </div>
          <h4 class="font-display font-semibold text-slate-800 text-sm group-hover:text-amber-900 leading-snug mb-1">
            ${escapeHtml(art.title)}
          </h4>
          <p class="text-xs text-slate-600 line-clamp-2">
            ${escapeHtml(art.snippet || '')}
          </p>
          <div class="mt-2 flex items-center justify-between text-[11px]">
            <span class="text-emerald-700 font-semibold flex items-center gap-1">
              <span>📖</span> Earns +10 TP
            </span>
            <span class="text-amber-700 group-hover:translate-x-0.5 transition font-bold flex items-center gap-0.5">
              Read article ↗
            </span>
          </div>
        </div>
      `).join('');
    }

    /* ==========================================================================
       6. UI EVENT HANDLERS & MODAL CONTROLLERS
       ========================================================================== */
    function setupEventListeners() {
      // Session Action Controls
      document.getElementById('startBtn').addEventListener('click', startSession);
      document.getElementById('pauseBtn').addEventListener('click', togglePause);
      document.getElementById('abortBtn').addEventListener('click', abortSession);
      document.getElementById('flushBtn').addEventListener('click', flushAndLogSession);

      // Category Switching in News Lounge
      document.querySelectorAll('.cat-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          document.querySelectorAll('.cat-btn').forEach(b => {
            b.className = 'cat-btn px-3 py-1.5 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200 shrink-0 transition';
          });
          btn.className = 'cat-btn px-3 py-1.5 rounded-xl bg-amber-800 text-white shadow-xs shrink-0 transition';
          activeCategory = btn.dataset.cat;
          sound.playChime();
          fetchNewsForCategory(activeCategory);
        });
      });

      document.getElementById('refreshFeedBtn').addEventListener('click', () => {
        sound.playChime();
        fetchNewsForCategory(activeCategory);
      });

      // Leaderboard sorting tabs
      const sortEarningsBtn = document.getElementById('sortEarningsBtn');
      const sortPointsBtn = document.getElementById('sortPointsBtn');
      const sortRecentBtn = document.getElementById('sortRecentBtn');

      function updateSortButtons(activeBtn) {
        [sortEarningsBtn, sortPointsBtn, sortRecentBtn].forEach(b => {
          b.className = 'px-3 py-1 rounded-lg text-slate-500 hover:text-slate-800';
        });
        activeBtn.className = 'px-3 py-1 rounded-lg bg-white shadow-xs text-slate-800 font-bold';
      }

      sortEarningsBtn.addEventListener('click', () => {
        currentSortMode = 'earnings';
        updateSortButtons(sortEarningsBtn);
        renderHistoryAndStats();
      });

      sortPointsBtn.addEventListener('click', () => {
        currentSortMode = 'points';
        updateSortButtons(sortPointsBtn);
        renderHistoryAndStats();
      });

      sortRecentBtn.addEventListener('click', () => {
        currentSortMode = 'recent';
        updateSortButtons(sortRecentBtn);
        renderHistoryAndStats();
      });

      // Clear records button
      document.getElementById('clearDataBtn').addEventListener('click', () => {
        if (confirm("Reset all stored flushes and lifetime statistics? This cannot be undone.")) {
          AppState.sessions = [];
          saveState();
          renderHistoryAndStats();
        }
      });

      // Profile Modal
      const profileModal = document.getElementById('profileModal');
      const profileBtn = document.getElementById('profileBtn');
      const closeProfileBtn = document.getElementById('closeProfileBtn');
      const saveProfileBtn = document.getElementById('saveProfileBtn');
      const randomizeNameBtn = document.getElementById('randomizeNameBtn');
      const throneNameInput = document.getElementById('throneNameInput');

      profileBtn.addEventListener('click', () => {
        sound.playChime();
        throneNameInput.value = AppState.user.throneName;
        profileModal.classList.remove('hidden');
      });

      closeProfileBtn.addEventListener('click', () => profileModal.classList.add('hidden'));

      randomizeNameBtn.addEventListener('click', () => {
        sound.playChime();
        throneNameInput.value = getRandomThroneName();
      });

      saveProfileBtn.addEventListener('click', () => {
        const val = throneNameInput.value.trim();
        if (val) {
          AppState.user.throneName = val;
          document.getElementById('navThroneName').textContent = val;
          saveState();
          sound.playChime();
          profileModal.classList.add('hidden');
        }
      });

      // Settings Modal
      const settingsModal = document.getElementById('settingsModal');
      const settingsBtn = document.getElementById('settingsBtn');
      const closeSettingsBtn = document.getElementById('closeSettingsBtn');
      const saveSettingsBtn = document.getElementById('saveSettingsBtn');
      const wageTypeHourly = document.getElementById('wageTypeHourly');
      const wageTypeSalary = document.getElementById('wageTypeSalary');
      const wageInput = document.getElementById('wageInput');
      const wageInputLabel = document.getElementById('wageInputLabel');
      const hoursPerWeekContainer = document.getElementById('hoursPerWeekContainer');
      const hoursPerWeekInput = document.getElementById('hoursPerWeekInput');
      const wageBreakdownHelper = document.getElementById('wageBreakdownHelper');

      let modalWageType = AppState.user.wageType;

      function updateWageModalDisplay() {
        if (modalWageType === 'hourly') {
          wageTypeHourly.className = 'py-2 px-3 rounded-xl border-2 border-amber-800 bg-amber-50 text-amber-900 font-bold text-sm';
          wageTypeSalary.className = 'py-2 px-3 rounded-xl border border-slate-200 bg-white text-slate-600 font-semibold text-sm';
          wageInputLabel.textContent = 'Hourly Rate (USD $)';
          hoursPerWeekContainer.classList.add('hidden');
          wageInput.value = AppState.user.hourlyRate;
          wageBreakdownHelper.textContent = `Generates approx $${((AppState.user.hourlyRate || 35) / 3600).toFixed(4)}/sec on company time.`;
        } else {
          wageTypeSalary.className = 'py-2 px-3 rounded-xl border-2 border-amber-800 bg-amber-50 text-amber-900 font-bold text-sm';
          wageTypeHourly.className = 'py-2 px-3 rounded-xl border border-slate-200 bg-white text-slate-600 font-semibold text-sm';
          wageInputLabel.textContent = 'Annual Salary (USD $)';
          hoursPerWeekContainer.classList.remove('hidden');
          wageInput.value = AppState.user.annualSalary;
          const weeklyHrs = AppState.user.hoursPerWeek || 40;
          const hourlyEquiv = AppState.user.annualSalary / (weeklyHrs * 52);
          wageBreakdownHelper.textContent = `Equates to approx $${hourlyEquiv.toFixed(2)}/hr ($${(hourlyEquiv / 3600).toFixed(4)}/sec).`;
        }
      }

      settingsBtn.addEventListener('click', () => {
        sound.playChime();
        modalWageType = AppState.user.wageType;
        hoursPerWeekInput.value = AppState.user.hoursPerWeek;
        updateWageModalDisplay();
        settingsModal.classList.remove('hidden');
      });

      closeSettingsBtn.addEventListener('click', () => settingsModal.classList.add('hidden'));

      wageTypeHourly.addEventListener('click', () => {
        modalWageType = 'hourly';
        updateWageModalDisplay();
      });

      wageTypeSalary.addEventListener('click', () => {
        modalWageType = 'salary';
        updateWageModalDisplay();
      });

      wageInput.addEventListener('input', () => {
        const val = parseFloat(wageInput.value) || 0;
        if (modalWageType === 'hourly') {
          wageBreakdownHelper.textContent = `Generates approx $${(val / 3600).toFixed(4)}/sec on company time.`;
        } else {
          const weeklyHrs = parseFloat(hoursPerWeekInput.value) || 40;
          const hourlyEquiv = val / (weeklyHrs * 52);
          wageBreakdownHelper.textContent = `Equates to approx $${hourlyEquiv.toFixed(2)}/hr ($${(hourlyEquiv / 3600).toFixed(4)}/sec).`;
        }
      });

      saveSettingsBtn.addEventListener('click', () => {
        sound.playChime();
        AppState.user.wageType = modalWageType;
        if (modalWageType === 'hourly') {
          AppState.user.hourlyRate = Math.max(1, parseFloat(wageInput.value) || 35);
        } else {
          AppState.user.annualSalary = Math.max(1000, parseFloat(wageInput.value) || 72800);
          AppState.user.hoursPerWeek = Math.max(1, parseFloat(hoursPerWeekInput.value) || 40);
        }
        saveState();
        updateRateBadges();
        settingsModal.classList.add('hidden');
      });

      // Sponsor Modal
      const sponsorBtn = document.getElementById('sponsorBtn');
      const sponsorModal = document.getElementById('sponsorModal');
      const closeSponsorBtn = document.getElementById('closeSponsorBtn');
      const sendSponsorEmailBtn = document.getElementById('sendSponsorEmailBtn');

      sponsorBtn.addEventListener('click', () => {
        sound.playChime();
        sponsorModal.classList.remove('hidden');
      });
      closeSponsorBtn.addEventListener('click', () => sponsorModal.classList.add('hidden'));
      sendSponsorEmailBtn.addEventListener('click', () => {
        window.location.href = "mailto:sponsors@pooppay.internal?subject=Sponsoring%20The%20Throne%20Lounge&body=Hi%20PoopPay%20team,%20I'd%20like%20to%20reach%20high-income%20corporate%20talent%20on%20company%20time!";
      });
    }

    /* ==========================================================================
       7. APPLICATION INITIALIZATION
       ========================================================================== */
    window.addEventListener('DOMContentLoaded', () => {
      loadState();
      
      // Update UI with stored values
      document.getElementById('navThroneName').textContent = AppState.user.throneName;
      updateRateBadges();
      renderHistoryAndStats();
      setupEventListeners();
      
      // Load initial reading newsfeed
      fetchNewsForCategory('tech');
    });
  </script>
</body>
</html>
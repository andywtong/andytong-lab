<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PoopPay 🧻 Throne Tracker & Reading Lounge</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts: Fredoka & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  
  <!-- Canvas Confetti for the Victory Flush -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            display: ['Fredoka', 'cursive', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            throne: {
              50: '#fdf8f6',
              100: '#f2e8e5',
              200: '#eaddd7',
              500: '#b08968',
              600: '#7f5539',
              800: '#533c2e',
              900: '#34251c',
            },
            wealth: {
              400: '#34d399',
              500: '#10b981',
              600: '#059669',
            }
          },
          keyframes: {
            floatBadge: {
              '0%': { opacity: '0', transform: 'translateY(10px) scale(0.8)' },
              '30%': { opacity: '1', transform: 'translateY(-10px) scale(1.1)' },
              '100%': { opacity: '0', transform: 'translateY(-35px) scale(0.9)' }
            },
            subtlePulse: {
              '0%, 100%': { transform: 'scale(1)' },
              '50%': { transform: 'scale(1.02)' }
            }
          },
          animation: {
            floatBadge: 'floatBadge 1.4s ease-out forwards',
            subtlePulse: 'subtlePulse 3s infinite ease-in-out',
          }
        }
      }
    }
  </script>

  <style>
    /* Custom scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
    .tabular-nums {
      font-variant-numeric: tabular-nums;
    }
  </style>
</head>
<body class="bg-amber-50/40 text-slate-800 font-sans min-h-screen flex flex-col antialiased selection:bg-amber-200 selection:text-amber-900">

  <!-- Top Navigation Bar -->
  <header class="bg-white/80 backdrop-blur-md sticky top-0 z-40 border-b border-amber-100/80 px-4 py-3 sm:px-6">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <!-- Logo -->
      <div class="flex items-center space-x-2">
        <span class="text-3xl filter drop-shadow">🧻</span>
        <div>
          <h1 class="text-2xl font-bold font-display tracking-tight text-amber-900 flex items-center gap-1.5 leading-none">
            PoopPay <span class="text-xs bg-emerald-100 text-emerald-800 font-sans font-semibold px-2 py-0.5 rounded-full border border-emerald-200">PROFIT V2</span>
          </h1>
          <p class="text-[11px] text-amber-700/80 font-medium">Reclaiming corporate wealth, drop by drop</p>
        </div>
      </div>

      <!-- User Profile Badge & Quick Settings -->
      <div class="flex items-center gap-2 sm:gap-3">
        <button id="profileBtn" class="flex items-center gap-2 bg-amber-100/60 hover:bg-amber-100 border border-amber-200/80 px-3 py-1.5 rounded-xl transition shadow-sm text-sm font-medium text-amber-950">
          <span class="text-base">👑</span>
          <span id="navThroneName" class="font-display font-semibold truncate max-w-[120px] sm:max-w-xs">PlungerKing_99</span>
          <span class="text-xs opacity-60">✏️</span>
        </button>

        <button id="settingsBtn" class="p-2 rounded-xl bg-white border border-slate-200 hover:bg-slate-50 transition shadow-sm text-slate-700" title="Wage Settings">
          ⚙️
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content Layout -->
  <main class="flex-grow max-w-6xl mx-auto w-full p-4 sm:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6">

    <!-- LEFT COLUMN: Tracker Dashboard & Stats (lg:col-span-7) -->
    <section class="lg:col-span-7 space-y-6">
      
      <!-- Primary Throne Counter Card -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-xl shadow-amber-950/5 border border-amber-100/80 relative overflow-hidden">
        
        <!-- Subtle background deco -->
        <div class="absolute -right-10 -bottom-10 text-9xl text-amber-50/50 pointer-events-none select-none font-display">🚽</div>
        
        <!-- Status indicator bar -->
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <span id="sessionStatusDot" class="w-3 h-3 rounded-full bg-slate-300"></span>
            <span id="sessionStatusText" class="text-xs font-bold tracking-wider uppercase text-slate-400">Throne Vacant</span>
          </div>
          <div class="text-xs bg-slate-100 text-slate-600 px-3 py-1 rounded-full font-mono font-medium flex items-center gap-1.5">
            <span>Rate:</span>
            <span id="ratePreviewBadge" class="font-bold text-slate-900">$35.00/hr ($0.0097/s)</span>
          </div>
        </div>

        <!-- Timer Display -->
        <div class="text-center my-3">
          <div id="sessionTimer" class="font-mono text-5xl sm:text-6xl font-extrabold text-slate-800 tracking-tight tabular-nums">
            00:00<span class="text-2xl text-slate-400">.0</span>
          </div>
          <p class="text-xs text-slate-400 mt-1 uppercase tracking-widest font-semibold">Active Session Duration</p>
        </div>

        <!-- Dual Live Ticker Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-6 relative">
          
          <!-- Box 1: Money Reclaimed -->
          <div class="bg-gradient-to-br from-emerald-500/10 via-emerald-500/5 to-transparent border border-emerald-200/80 rounded-2xl p-4 text-center relative overflow-hidden">
            <span class="text-xs font-bold text-emerald-800 uppercase tracking-wider block mb-1">Corporate Pay Reclaimed</span>
            <div class="font-mono text-3xl sm:text-4xl font-extrabold text-emerald-600 tabular-nums" id="liveMoneyTally">
              $0.000
            </div>
            <p class="text-[11px] text-emerald-700/80 mt-1">Boss makes a dollar, you make a dime</p>
          </div>

          <!-- Box 2: TurdPoints (Gamification) -->
          <div class="bg-gradient-to-br from-amber-500/10 via-amber-500/5 to-transparent border border-amber-200/80 rounded-2xl p-4 text-center relative overflow-hidden">
            <span class="text-xs font-bold text-amber-800 uppercase tracking-wider block mb-1">TurdPoints™ Earned</span>
            <div class="font-mono text-3xl sm:text-4xl font-extrabold text-amber-600 tabular-nums flex items-center justify-center gap-1" id="livePointsTally">
              0 <span class="text-sm font-normal text-amber-700">TP</span>
            </div>
            <p class="text-[11px] text-amber-700/80 mt-1" id="pointsSubtext">Includes reading bonus & throne time</p>
            
            <!-- Float bonus notification anchor -->
            <div id="badgeContainer" class="absolute inset-0 pointer-events-none flex items-center justify-center"></div>
          </div>
        </div>

        <!-- Core Session Control Buttons -->
        <div class="space-y-3">
          <!-- Primary Big Action Button -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <button id="startBtn" class="w-full py-4 px-6 rounded-2xl font-display font-bold text-lg text-white bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-700 hover:to-amber-800 active:scale-[0.98] transition shadow-lg shadow-amber-700/25 flex items-center justify-center gap-2">
              <span>🚽</span> Initiate Session
            </button>
            
            <button id="pauseBtn" disabled class="w-full py-4 px-6 rounded-2xl font-display font-bold text-lg text-slate-700 bg-slate-100 hover:bg-slate-200 disabled:opacity-40 disabled:cursor-not-allowed active:scale-[0.98] transition flex items-center justify-center gap-2 border border-slate-200">
              <span id="pauseBtnIcon">⏸️</span> <span id="pauseBtnText">Hold It (Pause)</span>
            </button>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
            <button id="flushBtn" disabled class="w-full py-3 px-5 rounded-2xl font-display font-bold text-base text-white bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 disabled:opacity-40 disabled:cursor-not-allowed active:scale-[0.98] transition shadow-md shadow-emerald-700/20 flex items-center justify-center gap-2">
              <span>🌊</span> Flush & Log
            </button>
            
            <button id="abortBtn" disabled class="w-full py-3 px-5 rounded-2xl font-display font-semibold text-base text-rose-600 bg-rose-50 hover:bg-rose-100 disabled:opacity-40 disabled:cursor-not-allowed active:scale-[0.98] transition border border-rose-200/80 flex items-center justify-center gap-2">
              <span>🛑</span> Abort Mission
            </button>
          </div>
        </div>
      </div>

      <!-- Lifetime Stats Cards Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="bg-white p-4 rounded-2xl border border-amber-100/80 shadow-sm text-center">
          <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block">Career Paid</span>
          <span id="statTotalPay" class="font-mono text-xl sm:text-2xl font-bold text-emerald-600 tabular-nums">$0.00</span>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-amber-100/80 shadow-sm text-center">
          <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block">Total Flushes</span>
          <span id="statTotalFlushes" class="font-mono text-xl sm:text-2xl font-bold text-slate-800 tabular-nums">0</span>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-amber-100/80 shadow-sm text-center">
          <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block">Throne Time</span>
          <span id="statTotalTime" class="font-mono text-lg sm:text-xl font-bold text-amber-900 tabular-nums">0m</span>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-amber-100/80 shadow-sm text-center">
          <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block">Avg Flush Value</span>
          <span id="statAvgValue" class="font-mono text-xl sm:text-2xl font-bold text-amber-700 tabular-nums">$0.00</span>
        </div>
      </div>

      <!-- Local Leaderboard & Hall of Flushes -->
      <div class="bg-white rounded-3xl p-6 shadow-sm border border-amber-100/80">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4 pb-3 border-b border-slate-100">
          <div>
            <h3 class="font-display font-bold text-lg text-slate-800 flex items-center gap-2">
              🏆 Hall of Flushes (Personal Best & Logs)
            </h3>
            <p class="text-xs text-slate-500">All data stored locally in your browser (100% private)</p>
          </div>

          <!-- Sort Toggle Buttons -->
          <div class="inline-flex rounded-xl bg-slate-100 p-1 text-xs font-semibold self-start sm:self-auto">
            <button id="sortEarningsBtn" class="px-3 py-1 rounded-lg bg-white shadow-xs text-slate-800">Top Pay 💵</button>
            <button id="sortPointsBtn" class="px-3 py-1 rounded-lg text-slate-500 hover:text-slate-800">TurdPoints ⭐</button>
            <button id="sortRecentBtn" class="px-3 py-1 rounded-lg text-slate-500 hover:text-slate-800">Recent 🕒</button>
          </div>
        </div>

        <!-- Leaderboard Table / History List -->
        <div id="sessionHistoryList" class="space-y-2 max-h-72 overflow-y-auto pr-1">
          <!-- Rendered dynamically -->
        </div>

        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
          <span>Keep your browser cache to preserve records.</span>
          <button id="clearDataBtn" class="text-rose-500 hover:text-rose-700 font-medium">Reset Data</button>
        </div>
      </div>

      <!-- Cheeky Monetization / Self-Serve Ad Space -->
      <div class="bg-gradient-to-r from-amber-900 via-amber-800 to-stone-900 text-white rounded-3xl p-5 shadow-lg border border-amber-700/50 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-amber-500/20 border border-amber-400/30 flex items-center justify-center text-2xl shrink-0">
            💼
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-[10px] font-bold tracking-widest uppercase bg-amber-500/30 text-amber-300 px-2 py-0.5 rounded-full">Sponsor Opportunity</span>
              <span class="text-xs text-amber-200/80">Captive High-Income Audience</span>
            </div>
            <h4 class="font-display font-bold text-base sm:text-lg mt-0.5">Advertise to captive talent on company time!</h4>
            <p class="text-xs text-amber-200/70">Reach professionals when they have literally nothing else to do.</p>
          </div>
        </div>
        <button id="sponsorBtn" class="whitespace-nowrap w-full sm:w-auto px-4 py-2.5 bg-gradient-to-r from-amber-400 to-amber-300 hover:from-amber-300 hover:to-amber-200 text-amber-950 font-bold rounded-xl text-xs transition shadow font-display">
          Claim Throne Space 🚀
        </button>
      </div>

    </section>

    <!-- RIGHT COLUMN: Gamified Throne Reading Lounge (lg:col-span-5) -->
    <section class="lg:col-span-5 flex flex-col space-y-4">
      
      <div class="bg-white rounded-3xl p-5 sm:p-6 shadow-xl shadow-amber-950/5 border border-amber-100/80 flex-grow flex flex-col">
        
        <!-- Header -->
        <div class="flex items-center justify-between mb-3">
          <div>
            <h2 class="font-display font-bold text-xl text-slate-800 flex items-center gap-2">
              🛋️ Throne Reading Lounge
            </h2>
            <p class="text-xs text-slate-500">Read news while doing business. Earns <strong>+10 TP / 15s</strong> bonus!</p>
          </div>
          
          <div id="readingBonusPill" class="hidden text-xs bg-emerald-100 border border-emerald-300 text-emerald-800 px-2.5 py-1 rounded-full font-bold flex items-center gap-1 animate-pulse">
            <span>📖</span> Active Reader (+10 TP)
          </div>
        </div>

        <!-- News Category Tabs -->
        <div class="flex gap-1.5 overflow-x-auto pb-2 border-b border-slate-100 text-xs font-semibold no-scrollbar" id="categoryTabs">
          <button data-cat="tech" class="cat-btn px-3 py-1.5 rounded-xl bg-amber-800 text-white shadow-xs shrink-0 transition">💻 Tech</button>
          <button data-cat="finance" class="cat-btn px-3 py-1.5 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200 shrink-0 transition">📈 Finance</button>
          <button data-cat="science" class="cat-btn px-3 py-1.5 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200 shrink-0 transition">🔬 Science</button>
          <button data-cat="weird" class="cat-btn px-3 py-1.5 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200 shrink-0 transition">🤪 Weird News</button>
          <button data-cat="history" class="cat-btn px-3 py-1.5 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200 shrink-0 transition">📜 History</button>
        </div>

        <!-- News Feed Container -->
        <div id="newsFeedList" class="mt-4 space-y-3 overflow-y-auto max-h-[580px] flex-grow pr-1">
          <!-- Feed items injected via JS -->
          <div class="text-center py-12 text-slate-400">
            <div class="inline-block animate-spin text-2xl mb-2">🌀</div>
            <p class="text-xs">Gathering fresh reading material for your session...</p>
          </div>
        </div>

        <!-- Feed footer info -->
        <div class="mt-3 pt-3 border-t border-slate-100 text-[11px] text-slate-400 flex items-center justify-between">
          <span>Live RSS with sandboxed click-safe routing</span>
          <button id="refreshFeedBtn" class="text-amber-800 font-semibold hover:underline flex items-center gap-1">
            🔄 Refresh
          </button>
        </div>

      </div>

    </section>

  </main>

  <!-- MODAL: Compensation Settings -->
  <div id="settingsModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-amber-100">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
        <h3 class="font-display font-bold text-xl text-slate-800 flex items-center gap-2">
          ⚙️ Wage & Ticker Config
        </h3>
        <button id="closeSettingsBtn" class="text-slate-400 hover:text-slate-600 text-xl font-bold p-1">&times;</button>
      </div>

      <div class="space-y-4">
        <!-- Wage Type Selector -->
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase mb-2">Compensation Format</label>
          <div class="grid grid-cols-2 gap-2">
            <button id="wageTypeHourly" class="py-2 px-3 rounded-xl border-2 border-amber-800 bg-amber-50 text-amber-900 font-bold text-sm">Hourly Wage ($/hr)</button>
            <button id="wageTypeSalary" class="py-2 px-3 rounded-xl border border-slate-200 bg-white text-slate-600 font-semibold text-sm">Annual Salary ($/yr)</button>
          </div>
        </div>

        <!-- Wage Input Field -->
        <div>
          <label id="wageInputLabel" class="block text-xs font-semibold text-slate-700 mb-1">Hourly Rate (USD $)</label>
          <div class="relative">
            <span class="absolute left-3.5 top-3 text-slate-400 font-bold text-base">$</span>
            <input type="number" id="wageInput" step="0.25" min="1" value="35.00" class="w-full pl-8 pr-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 font-mono font-bold text-lg text-slate-800" />
          </div>
          <p id="wageBreakdownHelper" class="text-[11px] text-slate-500 mt-1">Generates approx $0.0097 per second on company time.</p>
        </div>

        <!-- Working Hours per week (for salary calculations) -->
        <div id="hoursPerWeekContainer" class="hidden">
          <label class="block text-xs font-semibold text-slate-700 mb-1">Hours Worked per Week</label>
          <input type="number" id="hoursPerWeekInput" min="1" max="100" value="40" class="w-full px-4 py-2 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 font-mono text-sm" />
        </div>

        <div class="pt-4 flex gap-3">
          <button id="saveSettingsBtn" class="flex-1 py-3 bg-amber-800 hover:bg-amber-900 text-white font-display font-bold rounded-xl transition shadow">Save Preferences</button>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL: Throne Identity Profile -->
  <div id="profileModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-amber-100">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
        <h3 class="font-display font-bold text-xl text-slate-800 flex items-center gap-2">
          👑 Throne Identity
        </h3>
        <button id="closeProfileBtn" class="text-slate-400 hover:text-slate-600 text-xl font-bold p-1">&times;</button>
      </div>

      <div class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Your Throne Alias</label>
          <p class="text-xs text-slate-500 mb-2">This handle crowns all your company bathroom victories.</p>
          <div class="flex gap-2">
            <input type="text" id="throneNameInput" maxlength="24" class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 font-display font-bold text-base text-slate-800" />
            <button id="randomizeNameBtn" class="px-3 py-2 bg-amber-100 hover:bg-amber-200 border border-amber-300 rounded-xl text-xs font-bold text-amber-900 transition flex items-center gap-1" title="Reroll handle">
              🎲 Roll
            </button>
          </div>
        </div>

        <div class="bg-amber-50 rounded-2xl p-4 border border-amber-200/60">
          <h4 class="text-xs font-bold text-amber-900 uppercase tracking-wider mb-2">Throne Credentials</h4>
          <div class="space-y-1.5 text-xs text-amber-800">
            <div class="flex justify-between">
              <span>Account Mode:</span>
              <span class="font-bold">Local Encrypted Cache</span>
            </div>
            <div class="flex justify-between">
              <span>Rank Status:</span>
              <span id="profileRankBadge" class="font-bold text-emerald-700">Junior Flush Officer</span>
            </div>
          </div>
        </div>

        <div class="pt-2">
          <button id="saveProfileBtn" class="w-full py-3 bg-amber-800 hover:bg-amber-900 text-white font-display font-bold rounded-xl transition shadow">Save Identity</button>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL: Sponsor / Ad Space Contact -->
  <div id="sponsorModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-amber-100">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
        <h3 class="font-display font-bold text-xl text-slate-800 flex items-center gap-2">
          📢 Sponsor The Throne
        </h3>
        <button id="closeSponsorBtn" class="text-slate-400 hover:text-slate-600 text-xl font-bold p-1">&times;</button>
      </div>

      <div class="space-y-3 text-sm text-slate-600">
        <p>You have discovered the highest-attention, lowest-distraction ad inventory on the internet: <strong>corporate professionals actively being paid to sit on toilets</strong>.</p>
        
        <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200 text-xs space-y-1">
          <div class="flex justify-between"><span>Average dwell time:</span> <strong class="text-slate-800">8m 42s</strong></div>
          <div class="flex justify-between"><span>User state:</span> <strong class="text-slate-800">Relaxed & Contemplative</strong></div>
          <div class="flex justify-between"><span>Estimated CPM:</span> <strong class="text-emerald-600">$0.00 (Self-Serve Demo)</strong></div>
        </div>

        <p class="text-xs text-slate-500">Interested in placing your SaaS tool, newsletter, or funny gadget in front of high-earners?</p>
        
        <div class="pt-2">
          <button id="sendSponsorEmailBtn" class="w-full py-3 bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-700 hover:to-amber-800 text-white font-display font-bold rounded-xl transition shadow flex items-center justify-center gap-2">
            ✉️ Email Inquiry to Sponsors@PoopPay.internal
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Core JavaScript Engine -->
  <script>
    /* ==========================================================================
       1. WEB AUDIO API SYNTHESIZER (No external audio files needed)
       ========================================================================== */
    class ThroneSoundEngine {
      constructor() {
        this.ctx = null;
      }

      init() {
        if (!this.ctx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (AudioContext) {
            this.ctx = new AudioContext();
          }
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }

      // Quick pleasant chime for start / buttons
      playChime() {
        try {
          this.init();
          if (!this.ctx) return;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          
          osc.type = 'sine';
          osc.frequency.setValueAtTime(587.33, this.ctx.currentTime); // D5
          osc.frequency.exponentialRampToValueAtTime(880, this.ctx.currentTime + 0.15); // A5
          
          gain.gain.setValueAtTime(0.15, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.35);
          
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          
          osc.start();
          osc.stop(this.ctx.currentTime + 0.35);
        } catch (e) {
          console.warn('Audio not allowed yet', e);
        }
      }

      // Bonus point pop sound
      playPointBonus() {
        try {
          this.init();
          if (!this.ctx) return;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(659.25, this.ctx.currentTime); // E5
          osc.frequency.setValueAtTime(987.77, this.ctx.currentTime + 0.08); // B5
          
          gain.gain.setValueAtTime(0.2, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.25);
          
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          
          osc.start();
          osc.stop(this.ctx.currentTime + 0.25);
        } catch (e) {}
      }

      // Realistic synthetic water flush rush & bubbles
      playFlush() {
        try {
          this.init();
          if (!this.ctx) return;
          
          // White noise buffer for rushing water
          const bufferSize = this.ctx.sampleRate * 2.2;
          const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
          const data = buffer.getChannelData(0);
          for (let i = 0; i < bufferSize; i++) {
            data[i] = Math.random() * 2 - 1;
          }

          const noise = this.ctx.createBufferSource();
          noise.buffer = buffer;

          // Bandpass filter to sculpt swirling water whoosh
          const filter = this.ctx.createBiquadFilter();
          filter.type = 'bandpass';
          filter.frequency.setValueAtTime(700, this.ctx.currentTime);
          filter.frequency.exponentialRampToValueAtTime(1400, this.ctx.currentTime + 0.7);
          filter.frequency.exponentialRampToValueAtTime(250, this.ctx.currentTime + 2.0);
          filter.Q.setValueAtTime(2.5, this.ctx.currentTime);

          const gain = this.ctx.createGain();
          gain.gain.setValueAtTime(0.01, this.ctx.currentTime);
          gain.gain.linearRampToValueAtTime(0.4, this.ctx.currentTime + 0.3);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 2.1);

          noise.connect(filter);
          filter.connect(gain);
          gain.connect(this.ctx.destination);

          noise.start();
          noise.stop(this.ctx.currentTime + 2.2);

          // Add a lower resonant gurgle oscillator
          const gurgle = this.ctx.createOscillator();
          const gurgleGain = this.ctx.createGain();
          gurgle.type = 'triangle';
          gurgle.frequency.setValueAtTime(140, this.ctx.currentTime);
          gurgle.frequency.linearRampToValueAtTime(80, this.ctx.currentTime + 1.8);
          gurgleGain.gain.setValueAtTime(0.15, this.ctx.currentTime);
          gurgleGain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 2.0);

          gurgle.connect(gurgleGain);
          gurgleGain.connect(this.ctx.destination);
          gurgle.start();
          gurgle.stop(this.ctx.currentTime + 2.0);

        } catch (e) {
          console.warn('Audio flush error:', e);
        }
      }
    }

    const sound = new ThroneSoundEngine();

    /* ==========================================================================
       2. STATE & LOCALSTORAGE PERSISTENCE ENGINE
       ========================================================================== */
    const STORAGE_KEY = 'pooppay_throne_v2';

    const DEFAULT_NAMES = [
      'SirFlushesAlot', 'PlungerPat_42', 'DuchessOfDumps', 'CaptainClogger_99',
      'ThePorcelainKing', 'ThroneRaider_007', 'LordOfLoo', 'FlushGordon_88',
      'BaronVonBowels', 'PottyPotentate', 'StallStalker_23', 'BidetBandit'
    ];

    function getRandomThroneName() {
      const base = DEFAULT_NAMES[Math.floor(Math.random() * DEFAULT_NAMES.length)];
      return `${base}_${Math.floor(10 + Math.random() * 89)}`;
    }

    const AppState = {
      user: {
        throneName: getRandomThroneName(),
        wageType: 'hourly', // 'hourly' or 'salary'
        hourlyRate: 35.00,
        annualSalary: 72800,
        hoursPerWeek: 40
      },
      currentSession: {
        active: false,
        paused: false,
        elapsedSeconds: 0,
        currentEarnings: 0,
        currentPoints: 0,
        readingBonusCount: 0
      },
      sessions: [] // Array of past flushes
    };

    function loadState() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          const parsed = JSON.parse(saved);
          if (parsed.user) AppState.user = { ...AppState.user, ...parsed.user };
          if (Array.isArray(parsed.sessions)) AppState.sessions = parsed.sessions;
        }
      } catch (e) {
        console.error('Failed to load storage:', e);
      }
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({
          user: AppState.user,
          sessions: AppState.sessions
        }));
      } catch (e) {
        console.error('Failed to save storage:', e);
      }
    }

    /* Computes exact dollars earned per second */
    function getDollarPerSecond() {
      if (AppState.user.wageType === 'salary') {
        const totalYearHours = (AppState.user.hoursPerWeek || 40) * 52;
        const hourly = AppState.user.annualSalary / Math.max(1, totalYearHours);
        return hourly / 3600;
      } else {
        return (AppState.user.hourlyRate || 35) / 3600;
      }
    }

    function getHourlyEquivalent() {
      if (AppState.user.wageType === 'salary') {
        const totalYearHours = (AppState.user.hoursPerWeek || 40) * 52;
        return AppState.user.annualSalary / Math.max(1, totalYearHours);
      }
      return AppState.user.hourlyRate;
    }

    /* ==========================================================================
       3. TRACKING ENGINE TIMERS & POINT LOGIC
       ========================================================================== */
    let tickerInterval = null;
    let readingBonusInterval = null;
    let currentSortMode = 'earnings'; // 'earnings', 'points', 'recent'

    function updateRateBadges() {
      const perSec = getDollarPerSecond();
      const hourly = getHourlyEquivalent();
      const badge = document.getElementById('ratePreviewBadge');
      if (badge) {
        badge.textContent = `$${hourly.toFixed(2)}/hr ($${perSec.toFixed(4)}/s)`;
      }
    }

    function formatTime(seconds) {
      const m = Math.floor(seconds / 60);
      const s = Math.floor(seconds % 60);
      const tenths = Math.floor((seconds % 1) * 10);
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}<span class="text-2xl text-slate-400">.${tenths}</span>`;
    }

    function formatDurationClean(sec) {
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      return `${m}m ${s}s`;
    }

    function triggerBonusBadge(text = '+10 TP') {
      const container = document.getElementById('badgeContainer');
      if (!container) return;
      const badge = document.createElement('div');
      badge.className = 'font-display font-extrabold text-sm text-emerald-600 bg-white px-2.5 py-1 rounded-full shadow-md border border-emerald-300 animate-floatBadge select-none';
      badge.textContent = text;
      container.appendChild(badge);
      setTimeout(() => badge.remove(), 1400);
    }

    function tick() {
      if (!AppState.currentSession.active || AppState.currentSession.paused) return;

      // Add 0.1s increment
      AppState.currentSession.elapsedSeconds += 0.1;
      const ratePerSec = getDollarPerSecond();
      AppState.currentSession.currentEarnings += ratePerSec * 0.1;

      // Natural TurdPoints: 1 point every 2 seconds
      if (Math.round(AppState.currentSession.elapsedSeconds * 10) % 20 === 0) {
        AppState.currentSession.currentPoints += 1;
      }

      // Update UI Tally
      const timerEl = document.getElementById('sessionTimer');
      const moneyEl = document.getElementById('liveMoneyTally');
      const pointsEl = document.getElementById('livePointsTally');

      if (timerEl) timerEl.innerHTML = formatTime(AppState.currentSession.elapsedSeconds);
      if (moneyEl) moneyEl.textContent = `$${AppState.currentSession.currentEarnings.toFixed(3)}`;
      if (pointsEl) {
        pointsEl.innerHTML = `${AppState.currentSession.currentPoints} <span class="text-sm font-normal text-amber-700">TP</span>`;
      }
    }

    function startSession() {
      sound.playChime();
      AppState.currentSession.active = true;
      AppState.currentSession.paused = false;
      AppState.currentSession.elapsedSeconds = 0;
      AppState.currentSession.currentEarnings = 0;
      AppState.currentSession.currentPoints = 10; // Baseline entry bonus!
      AppState.currentSession.readingBonusCount = 0;

      // Update Controls State
      document.getElementById('startBtn').disabled = true;
      document.getElementById('pauseBtn').disabled = false;
      document.getElementById('flushBtn').disabled = false;
      document.getElementById('abortBtn').disabled = false;

      // Update Status indicator
      const dot = document.getElementById('sessionStatusDot');
      const text = document.getElementById('sessionStatusText');
      dot.className = 'w-3 h-3 rounded-full bg-emerald-500 animate-pulse';
      text.textContent = 'Session In Progress';
      text.className = 'text-xs font-bold tracking-wider uppercase text-emerald-600';

      document.getElementById('readingBonusPill').classList.remove('hidden');

      // Clear any prior interval & launch high-frequency tick
      clearInterval(tickerInterval);
      clearInterval(readingBonusInterval);

      tickerInterval = setInterval(tick, 100);

      // Active reading lounge bonus: +10 TP every 15 seconds
      readingBonusInterval = setInterval(() => {
        if (AppState.currentSession.active && !AppState.currentSession.paused) {
          AppState.currentSession.currentPoints += 10;
          AppState.currentSession.readingBonusCount += 1;
          sound.playPointBonus();
          triggerBonusBadge('+10 TP Reading Bonus!');
          const pointsEl = document.getElementById('livePointsTally');
          if (pointsEl) {
            pointsEl.innerHTML = `${AppState.currentSession.currentPoints} <span class="text-sm font-normal text-amber-700">TP</span>`;
          }
        }
      }, 15000);
    }

    function togglePause() {
      if (!AppState.currentSession.active) return;
      sound.playChime();
      AppState.currentSession.paused = !AppState.currentSession.paused;

      const pauseIcon = document.getElementById('pauseBtnIcon');
      const pauseText = document.getElementById('pauseBtnText');
      const dot = document.getElementById('sessionStatusDot');
      const text = document.getElementById('sessionStatusText');

      if (AppState.currentSession.paused) {
        pauseIcon.textContent = '▶️';
        pauseText.textContent = 'Resume Mission';
        dot.className = 'w-3 h-3 rounded-full bg-amber-400';
        text.textContent = 'Holding It (Paused)';
        text.className = 'text-xs font-bold tracking-wider uppercase text-amber-600';
      } else {
        pauseIcon.textContent = '⏸️';
        pauseText.textContent = 'Hold It (Pause)';
        dot.className = 'w-3 h-3 rounded-full bg-emerald-500 animate-pulse';
        text.textContent = 'Session In Progress';
        text.className = 'text-xs font-bold tracking-wider uppercase text-emerald-600';
      }
    }

    function abortSession() {
      if (!confirm("Are you sure you want to abort? All earnings for this current session will be discarded!")) {
        return;
      }
      resetSessionUI();
    }

    function flushAndLogSession() {
      if (!AppState.currentSession.active) return;

      // Play synthesized audio and confetti burst
      sound.playFlush();
      if (window.confetti) {
        confetti({
          particleCount: 80,
          spread: 70,
          origin: { y: 0.6 },
          colors: ['#10b981', '#f59e0b', '#3b82f6', '#b08968']
        });
      }

      // Record session
      const newRecord = {
        id: 'flush_' + Date.now(),
        throneName: AppState.user.throneName,
        durationSeconds: AppState.currentSession.elapsedSeconds,
        earnings: AppState.currentSession.currentEarnings,
        points: AppState.currentSession.currentPoints,
        timestamp: new Date().toISOString()
      };

      AppState.sessions.unshift(newRecord);
      saveState();

      // Refresh boards
      renderHistoryAndStats();
      resetSessionUI();
    }

    function resetSessionUI() {
      clearInterval(tickerInterval);
      clearInterval(readingBonusInterval);

      AppState.currentSession.active = false;
      AppState.currentSession.paused = false;
      AppState.currentSession.elapsedSeconds = 0;
      AppState.currentSession.currentEarnings = 0;
      AppState.currentSession.currentPoints = 0;

      document.getElementById('startBtn').disabled = false;
      document.getElementById('pauseBtn').disabled = true;
      document.getElementById('flushBtn').disabled = true;
      document.getElementById('abortBtn').disabled = true;

      document.getElementById('pauseBtnIcon').textContent = '⏸️';
      document.getElementById('pauseBtnText').textContent = 'Hold It (Pause)';

      const dot = document.getElementById('sessionStatusDot');
      const text = document.getElementById('sessionStatusText');
      dot.className = 'w-3 h-3 rounded-full bg-slate-300';
      text.textContent = 'Throne Vacant';
      text.className = 'text-xs font-bold tracking-wider uppercase text-slate-400';

      document.getElementById('sessionTimer').innerHTML = '00:00<span class="text-2xl text-slate-400">.0</span>';
      document.getElementById('liveMoneyTally').textContent = '$0.000';
      document.getElementById('livePointsTally').innerHTML = '0 <span class="text-sm font-normal text-amber-700">TP</span>';
      document.getElementById('readingBonusPill').classList.add('hidden');
    }

    /* ==========================================================================
       4. LOCAL LEADERBOARD & STATS DASHBOARD
       ========================================================================== */
    function renderHistoryAndStats() {
      // 1. Calculate Aggregates
      const totalSessions = AppState.sessions.length;
      let totalPay = 0;
      let totalSec = 0;

      AppState.sessions.forEach(s => {
        totalPay += (s.earnings || 0);
        totalSec += (s.durationSeconds || 0);
      });

      const avgPay = totalSessions > 0 ? (totalPay / totalSessions) : 0;
      const totalMinutes = Math.round(totalSec / 60);

      document.getElementById('statTotalPay').textContent = `$${totalPay.toFixed(2)}`;
      document.getElementById('statTotalFlushes').textContent = totalSessions;
      document.getElementById('statTotalTime').textContent = `${totalMinutes}m`;
      document.getElementById('statAvgValue').textContent = `$${avgPay.toFixed(2)}`;

      // Update Profile Rank badge based on total sessions
      const rankBadge = document.getElementById('profileRankBadge');
      if (rankBadge) {
        if (totalSessions >= 25) rankBadge.textContent = 'Supreme Grand Porcelain Master 👑';
        else if (totalSessions >= 10) rankBadge.textContent = 'Senior Waste Management Strategist 🎖️';
        else if (totalSessions >= 3) rankBadge.textContent = 'Certified Corporate Drainer 🧻';
        else rankBadge.textContent = 'Junior Flush Officer 🚽';
      }

      // 2. Sort sessions according to active filter
      const sorted = [...AppState.sessions];
      if (currentSortMode === 'earnings') {
        sorted.sort((a, b) => (b.earnings || 0) - (a.earnings || 0));
      } else if (currentSortMode === 'points') {
        sorted.sort((a, b) => (b.points || 0) - (a.points || 0));
      } else {
        sorted.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
      }

      const listContainer = document.getElementById('sessionHistoryList');
      if (!listContainer) return;

      if (sorted.length === 0) {
        listContainer.innerHTML = `
          <div class="text-center py-8 text-slate-400">
            <span class="text-3xl block mb-1">📭</span>
            <p class="text-xs">No recorded flushes yet. Initiate a session and reclaim your first corporate dollar!</p>
          </div>
        `;
        return;
      }

      listContainer.innerHTML = sorted.map((s, idx) => {
        const medal = idx === 0 ? '🥇' : idx === 1 ? '🥈' : idx === 2 ? '🥉' : `#${idx + 1}`;
        const dateStr = new Date(s.timestamp).toLocaleDateString(undefined, {
          month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'
        });

        return `
          <div class="flex items-center justify-between p-3 rounded-2xl bg-amber-50/50 hover:bg-amber-100/40 border border-amber-100/60 transition text-xs">
            <div class="flex items-center gap-3">
              <span class="font-display font-bold text-sm w-6 text-center text-amber-900">${medal}</span>
              <div>
                <span class="font-display font-semibold text-slate-800 text-sm block">${escapeHtml(s.throneName || 'ThroneWarrior')}</span>
                <span class="text-[10px] text-slate-400">${dateStr} • Duration: ${formatDurationClean(s.durationSeconds)}</span>
              </div>
            </div>
            <div class="text-right">
              <span class="font-mono font-bold text-emerald-600 text-sm block">+$${Number(s.earnings || 0).toFixed(2)}</span>
              <span class="font-mono text-[11px] font-semibold text-amber-700">${s.points || 0} TP</span>
            </div>
          </div>
        `;
      }).join('');
    }

    function escapeHtml(str) {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    /* ==========================================================================
       5. GAMIFIED READING LOUNGE & RSS PARSING

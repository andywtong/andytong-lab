      badge.textContent = text;
      container.appendChild(badge);
      setTimeout(() => badge.remove(), 1400);
    }

    function tick() {
      if (!AppState.currentSession.active || AppState.currentSession.paused) return;

      AppState.currentSession.elapsedSeconds += 0.1;
      const ratePerSec = getDollarPerSecond();
      AppState.currentSession.currentEarnings += ratePerSec * 0.1;

      // Base time points: 1 point every 2 seconds
      if (Math.round(AppState.currentSession.elapsedSeconds * 10) % 20 === 0) {
        AppState.currentSession.currentPoints += 1;
      }

      const timerEl = document.getElementById('sessionTimer');
      const moneyEl = document.getElementById('liveMoneyTally');
      const pointsEl = document.getElementById('livePointsTally');

      if (timerEl) timerEl.innerHTML = formatTime(AppState.currentSession.elapsedSeconds);
      if (moneyEl) moneyEl.textContent = `$${AppState.currentSession.currentEarnings.toFixed(3)}`;
      if (pointsEl) {
        pointsEl.innerHTML = `${AppState.currentSession.currentPoints} <span class="text-sm font-normal text-amber-700">TP</span>`;
      }
    }

    // Secondary 1-second interval strictly managing the reading dwell requirement
    function readingTick() {
      const countdownEl = document.getElementById('dwellCountdownText');
      const activeIndicator = document.getElementById('activeReaderIndicator');

      // CRITICAL REQUIREMENT: Points only apply if session is active AND reader modal is open!
      if (AppState.currentSession.active && !AppState.currentSession.paused && AppState.reader.isOpen) {
        activeIndicator.classList.remove('hidden');
        AppState.reader.dwellTimer -= 1;

        if (countdownEl) {
          countdownEl.textContent = `Next +10 TP: ${AppState.reader.dwellTimer}s`;
        }

        if (AppState.reader.dwellTimer <= 0) {
          AppState.currentSession.currentPoints += 10;
          AppState.currentSession.readingBonusCount += 1;
          AppState.reader.dwellTimer = 15;
          sound.playPointBonus();
          triggerBonusBadge('+10 TP Reading Bonus!');

          const pointsEl = document.getElementById('livePointsTally');
          if (pointsEl) {
            pointsEl.innerHTML = `${AppState.currentSession.currentPoints} <span class="text-sm font-normal text-amber-700">TP</span>`;
          }
        }
      } else {
        activeIndicator.classList.add('hidden');
        if (countdownEl) {
          countdownEl.textContent = AppState.currentSession.active ? 'Paused / Reader Idle' : 'Start mission to earn';
        }
      }
    }

    function startSession() {
      sound.playChime();
      AppState.currentSession.active = true;
      AppState.currentSession.paused = false;
      AppState.currentSession.elapsedSeconds = 0;
      AppState.currentSession.currentEarnings = 0;
      AppState.currentSession.currentPoints = 10;
      AppState.currentSession.readingBonusCount = 0;

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TurdTally 🧻 The Ultimate Throne Tracker</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts: Fredoka & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  
  <!-- Canvas Confetti for the Victory Flush -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            display: ['Fredoka', 'cursive', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            throne: {
              50: '#fdf8f6',
              100: '#f2e8e5',
              200: '#eaddd7',
              500: '#b08968',
              600: '#7f5539',
              800: '#533c2e',
              900: '#34251c',
            }
          },
          keyframes: {
            floatBadge: {
              '0%': { opacity: '0', transform: 'translateY(10px) scale(0.8)' },
              '30%': { opacity: '1', transform: 'translateY(-10px) scale(1.1)' },
              '100%': { opacity: '0', transform: 'translateY(-35px) scale(0.9)' }
            }
          },
          animation: {
            floatBadge: 'floatBadge 1.4s ease-out forwards',
          }
        }
      }
    }
  </script>

  <style>
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    .tabular-nums { font-variant-numeric: tabular-nums; }
  </style>
</head>
<body class="bg-amber-50/40 text-slate-800 font-sans min-h-screen flex flex-col antialiased selection:bg-amber-200 selection:text-amber-900 pb-12">

  <!-- STICKY TOP HUD BAR: Stays pinned while scrolling -->
  <header class="bg-white/95 backdrop-blur-md sticky top-0 z-40 border-b border-amber-200/90 shadow-sm px-3 py-2 sm:px-6">
    <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <!-- Logo & Profile -->
      <div class="flex items-center gap-2 sm:gap-3">
        <span class="text-2xl filter drop-shadow">🧻</span>
        <div class="hidden sm:block">
          <h1 class="text-lg font-bold font-display text-amber-950 flex items-center gap-1.5 leading-none">
            TurdTally
          </h1>
          <p class="text-[10px] text-amber-700/80 font-medium">Reclaim Corporate Wealth</p>
        </div>
        <button id="profileBtn" class="flex items-center gap-1.5 bg-amber-100/70 hover:bg-amber-100 border border-amber-200 px-2.5 py-1 rounded-xl text-xs font-semibold text-amber-950">
          <span>👑</span>
          <span id="navThroneName" class="font-display truncate max-w-[90px] sm:max-w-[120px]">PlungerKing</span>
        </button>
      </div>

      <!-- Live Counters in Sticky Bar -->
      <div class="flex items-center gap-2 sm:gap-4 font-mono text-xs sm:text-sm">
        <!-- Time -->
        <div class="bg-slate-100 px-2 py-1 rounded-lg text-center">
          <span class="block text-[9px] uppercase font-sans font-bold text-slate-400">Duration</span>
          <span id="stickyTimer" class="font-bold text-slate-800 tabular-nums">00:00</span>
        </div>
        <!-- Reclaimed Cash -->
        <div class="bg-emerald-50 border border-emerald-200/80 px-2.5 py-1 rounded-lg text-center">
          <span class="block text-[9px] uppercase font-sans font-bold text-emerald-800">Paid</span>
          <span id="stickyMoney" class="font-extrabold text-emerald-600 tabular-nums">$0.00</span>
        </div>
        <!-- Total TurdPoints -->
        <div class="bg-amber-50 border border-amber-200/80 px-2.5 py-1 rounded-lg text-center">
          <span class="block text-[9px] uppercase font-sans font-bold text-amber-800">TurdPoints</span>
          <span id="stickyPoints" class="font-extrabold text-amber-600 tabular-nums">0 TP</span>
        </div>
      </div>

      <!-- Quick Action Toggle Button (Initiate / Finished Mission) -->
      <div class="flex items-center gap-1.5">
        <button id="stickyToggleBtn" class="px-3.5 py-1.5 rounded-xl font-display font-bold text-xs sm:text-sm text-white bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-700 hover:to-amber-800 active:scale-95 transition shadow-sm flex items-center gap-1.5 whitespace-nowrap">
          <span id="stickyToggleIcon">🚽</span>
          <span id="stickyToggleText">Initiate Mission</span>
        </button>
        <button id="jumpToLoungeBtn" class="hidden sm:flex text-xs bg-amber-100 hover:bg-amber-200 text-amber-900 border border-amber-300 font-bold px-2.5 py-1.5 rounded-xl items-center gap-1" title="Go to Throne Lounge">
          🛋️ Lounge
        </button>
      </div>
    </div>
  </header>

  <!-- LIVE SIMULATED PEER ROSTER BANNER (Safe & Privacy-Guaranteed) -->
  <div class="bg-amber-900 text-amber-100 text-xs py-1.5 px-4 overflow-hidden border-b border-amber-800 flex items-center gap-3">
    <span class="shrink-0 font-bold bg-amber-800 text-amber-200 px-2 py-0.5 rounded text-[10px] uppercase tracking-wider flex items-center gap-1">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span> Live Throne Wire
    </span>
    <div id="liveTickerMarquee" class="whitespace-nowrap overflow-hidden text-amber-200/90 text-[11px] font-mono flex-1">
      <!-- Dynamic simulated peer updates stream here -->
    </div>
  </div>

  <!-- Main Content Layout -->
  <main class="flex-grow max-w-6xl mx-auto w-full p-4 sm:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6">

    <!-- LEFT COLUMN: Tracker Dashboard & Controls (lg:col-span-7) -->
    <section class="lg:col-span-7 space-y-5">
      
      <!-- Primary Throne Counter Card -->
      <div class="bg-white rounded-3xl p-5 sm:p-7 shadow-xl shadow-amber-950/5 border border-amber-100/80 relative overflow-hidden">
        
        <div class="absolute -right-10 -bottom-10 text-9xl text-amber-50/50 pointer-events-none select-none font-display">🚽</div>
        
        <!-- Status indicator bar -->
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <span id="sessionStatusDot" class="w-3 h-3 rounded-full bg-slate-300"></span>
            <span id="sessionStatusText" class="text-xs font-bold tracking-wider uppercase text-slate-400">Throne Vacant</span>
          </div>
          <div id="activeReaderIndicator" class="hidden text-xs bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-0.5 rounded-full font-semibold animate-pulse">
            📖 Reading Active (+10 TP / 15s)
          </div>
        </div>

        <!-- Timer Display -->
        <div class="text-center my-2">
          <div id="sessionTimer" class="font-mono text-5xl sm:text-6xl font-extrabold text-slate-800 tracking-tight tabular-nums">
            00:00<span class="text-2xl text-slate-400">.0</span>
          </div>
          <p class="text-[11px] text-slate-400 mt-1 uppercase tracking-widest font-semibold">Stall Time Elapsed</p>
        </div>

        <!-- Ticker Grid: Reclaimed Cash & Detailed 3-Way Points Breakdown -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 my-4">
          <!-- Earnings -->
          <div class="bg-gradient-to-br from-emerald-500/10 via-emerald-500/5 to-transparent border border-emerald-200/80 rounded-2xl p-4 text-center">
            <span class="text-xs font-bold text-emerald-800 uppercase tracking-wider block mb-1">Corporate Pay Reclaimed</span>
            <div class="font-mono text-3xl sm:text-4xl font-extrabold text-emerald-600 tabular-nums" id="liveMoneyTally">
              $0.000
            </div>
            <p class="text-[11px] text-emerald-700/80 mt-1 font-medium">Earned while doing your business</p>
          </div>

          <!-- Gamified TurdPoints with 3-Way Split -->
          <div class="bg-gradient-to-br from-amber-500/10 via-amber-500/5 to-transparent border border-amber-200/80 rounded-2xl p-4 text-center relative overflow-hidden">
            <span class="text-xs font-bold text-amber-800 uppercase tracking-wider block mb-0.5">Total TurdPoints™</span>
            <div class="font-mono text-3xl sm:text-4xl font-extrabold text-amber-600 tabular-nums flex items-center justify-center gap-1" id="livePointsTally">
              0 <span class="text-sm font-normal text-amber-700">TP</span>
            </div>
            
            <!-- Granular Points Split Indicator -->
            <div class="mt-2 pt-2 border-t border-amber-200/50 flex justify-around text-[10px] font-mono text-amber-900">
              <div>
                <span class="text-slate-400 block font-sans font-bold">🚽 Stall TP</span>
                <span id="livePoopPoints" class="font-bold text-amber-800">0</span>
              </div>
              <div class="border-r border-amber-200/70"></div>
              <div>
                <span class="text-emerald-700 block font-sans font-bold">📖 Read TP</span>
                <span id="liveReadingPoints" class="font-bold text-emerald-700">0</span>
              </div>
            </div>

            <div id="badgeContainer" class="absolute inset-0 pointer-events-none flex items-center justify-center"></div>
          </div>
        </div>

        <!-- CALLOUT BANNER: Direct awareness for Throne Reading Lounge -->
        <div class="bg-gradient-to-r from-amber-500/15 via-orange-500/10 to-amber-500/15 border border-amber-300 rounded-2xl p-3 sm:p-3.5 mb-4 flex items-center justify-between gap-3 shadow-xs">
          <div class="flex items-center gap-2.5">
            <span class="text-2xl animate-bounce">🛋️</span>
            <div>
              <div class="flex items-center gap-1.5">
                <span class="text-xs font-bold text-amber-950 uppercase">Throne Reading Lounge</span>
                <span class="text-[9px] bg-emerald-600 text-white font-bold px-1.5 py-0.2 rounded-full">+10 TP / 15s</span>
              </div>
              <p class="text-[11px] text-amber-900/80 font-medium">Read articles while on the clock to speed up your TurdPoints score!</p>
            </div>
          </div>
          <button id="bannerToLoungeBtn" class="shrink-0 px-3 py-1.5 bg-amber-800 hover:bg-amber-900 text-white rounded-xl text-xs font-bold font-display shadow transition">
            Browse Feed ↓
          </button>
        </div>

        <!-- PROMINENT WAGE ADJUSTMENT BANNER -->
        <div class="my-3">
          <button id="prominentWageBtn" class="w-full p-3 rounded-2xl bg-amber-50 hover:bg-amber-100/80 border-2 border-dashed border-amber-300 hover:border-amber-400 transition flex items-center justify-between group shadow-xs">
            <div class="flex items-center gap-3 text-left">
              <div class="w-9 h-9 rounded-xl bg-amber-500/20 text-amber-900 flex items-center justify-center text-lg shrink-0">
                💰
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-[11px] font-bold text-amber-900 tracking-wide uppercase">Your Compensation Rate</span>
                  <span class="text-[9px] font-bold bg-amber-200 text-amber-900 px-1.5 py-0.2 rounded-full">Tap to Edit</span>
                </div>
                <div id="prominentWageDisplay" class="font-mono font-bold text-slate-800 text-sm sm:text-base">
                  $35.00/hr ($0.0097/sec)
                </div>
              </div>
            </div>
            <div class="text-amber-800 text-xs font-bold flex items-center gap-1 px-2.5 py-1 rounded-lg bg-white shadow-xs group-hover:scale-105 transition">
              <span>⚙️ Adjust</span>
            </div>
          </button>
        </div>

        <!-- Controls: Mission Start/Finish, Pause, Flush, Abort -->
        <div class="space-y-2.5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <button id="startBtn" class="w-full py-3.5 px-5 rounded-2xl font-display font-bold text-base text-white bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-700 hover:to-amber-800 active:scale-[0.98] transition shadow-lg shadow-amber-700/20 flex items-center justify-center gap-2">
              <span id="startBtnIcon">🚽</span> <span id="startBtnText">Initiate Mission</span>
            </button>
            
            <button id="pauseBtn" disabled class="w-full py-3.5 px-5 rounded-2xl font-display font-bold text-base text-slate-700 bg-slate-100 hover:bg-slate-200 disabled:opacity-40 disabled:cursor-not-allowed active:scale-[0.98] transition flex items-center justify-center gap-2 border border-slate-200">
              <span id="pauseBtnIcon">⏸️</span> <span id="pauseBtnText">Hold It (Pause)</span>
            </button>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-0.5">
            <button id="flushBtn" disabled class="w-full py-3 px-4 rounded-2xl font-display font-bold text-sm sm:text-base text-white bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 disabled:opacity-40 disabled:cursor-not-allowed active:scale-[0.98] transition shadow-md shadow-emerald-700/20 flex items-center justify-center gap-2">
              <span>🌊</span> Flush & Log Victory
            </button>
            
            <button id="abortBtn" disabled class="w-full py-3 px-4 rounded-2xl font-display font-semibold text-sm sm:text-base text-rose-600 bg-rose-50 hover:bg-rose-100 disabled:opacity-40 disabled:cursor-not-allowed active:scale-[0.98] transition border border-rose-200 flex items-center justify-center gap-2">
              <span>🛑</span> Abort Mission
            </button>
          </div>
        </div>
      </div>

      <!-- Lifetime Stats Cards Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
        <div class="bg-white p-3.5 rounded-2xl border border-amber-100/80 shadow-xs text-center">
          <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Career Paid</span>
          <span id="statTotalPay" class="font-mono text-lg sm:text-xl font-bold text-emerald-600 tabular-nums">$0.00</span>
        </div>
        <div class="bg-white p-3.5 rounded-2xl border border-amber-100/80 shadow-xs text-center">
          <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Total Flushes</span>
          <span id="statTotalFlushes" class="font-mono text-lg sm:text-xl font-bold text-slate-800 tabular-nums">0</span>
        </div>
        <div class="bg-white p-3.5 rounded-2xl border border-amber-100/80 shadow-xs text-center">
          <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Throne Time</span>
          <span id="statTotalTime" class="font-mono text-base sm:text-lg font-bold text-amber-900 tabular-nums">0m</span>
        </div>
        <div class="bg-white p-3.5 rounded-2xl border border-amber-100/80 shadow-xs text-center">
          <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Avg Flush</span>
          <span id="statAvgValue" class="font-mono text-lg sm:text-xl font-bold text-amber-700 tabular-nums">$0.00</span>
        </div>
      </div>

      <!-- Local Leaderboard & Hall of Flushes -->
      <div class="bg-white rounded-3xl p-5 sm:p-6 shadow-xs border border-amber-100/80">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3 pb-3 border-b border-slate-100">
          <div>
            <h3 class="font-display font-bold text-base sm:text-lg text-slate-800 flex items-center gap-2">
              🏆 Hall of Flushes (Personal Logs)
            </h3>
            <p class="text-xs text-slate-500">Points split between throne duration & active reading</p>
          </div>

          <div class="inline-flex rounded-xl bg-slate-100 p-1 text-xs font-semibold self-start sm:self-auto">
            <button id="sortEarningsBtn" class="px-2.5 py-1 rounded-lg bg-white shadow-xs text-slate-800">Top Pay 💵</button>
            <button id="sortPointsBtn" class="px-2.5 py-1 rounded-lg text-slate-500 hover:text-slate-800">Points ⭐</button>
            <button id="sortRecentBtn" class="px-2.5 py-1 rounded-lg text-slate-500 hover:text-slate-800">Recent 🕒</button>
          </div>
        </div>

        <div id="sessionHistoryList" class="space-y-2 max-h-72 overflow-y-auto pr-1"></div>

        <div class="mt-3 pt-2.5 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
          <span>Encrypted LocalStorage Only</span>
          <button id="clearDataBtn" class="text-rose-500 hover:text-rose-700 font-medium">Reset Data</button>
        </div>
      </div>

      <!-- Monetization Concept -->
      <div class="bg-gradient-to-r from-amber-900 via-amber-800 to-stone-900 text-white rounded-3xl p-4 sm:p-5 shadow-lg border border-amber-700/50 flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-amber-500/20 border border-amber-400/30 flex items-center justify-center text-xl shrink-0">
            💼
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-[9px] font-bold tracking-widest uppercase bg-amber-500/30 text-amber-300 px-2 py-0.5 rounded-full">Sponsor Desk</span>
              <span class="text-xs text-amber-200/80">Captive Throne Audience</span>
            </div>
            <h4 class="font-display font-bold text-sm sm:text-base mt-0.5">Reach decision makers with nowhere else to look</h4>
          </div>
        </div>
        <button id="sponsorBtn" class="w-full sm:w-auto px-4 py-2 bg-gradient-to-r from-amber-400 to-amber-300 hover:from-amber-300 text-amber-950 font-bold rounded-xl text-xs transition shadow font-display shrink-0">
          Claim Space 🚀
        </button>
      </div>

    </section>

    <!-- RIGHT COLUMN: Gamified Throne Reading Lounge (lg:col-span-5) -->
    <section id="readingLoungeSection" class="lg:col-span-5 flex flex-col space-y-4">
      
      <div class="bg-white rounded-3xl p-5 sm:p-6 shadow-xl shadow-amber-950/5 border border-amber-100/80 flex-grow flex flex-col">
        
        <!-- Header -->
        <div class="flex items-center justify-between mb-2">
          <div>
            <h2 class="font-display font-bold text-xl text-slate-800 flex items-center gap-2">
              🛋️ Throne Reading Lounge
            </h2>
            <p class="text-xs text-slate-500">Tap to open full articles & earn <strong>+10 TP / 15s</strong> active bonus</p>
          </div>
          
          <button id="customizeTopicsBtn" class="text-xs bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 px-2.5 py-1 rounded-xl font-bold transition flex items-center gap-1">
            <span>⚙️</span> Topics
          </button>
        </div>

        <!-- News Category Tabs -->
        <div class="flex gap-1.5 overflow-x-auto pb-2 border-b border-slate-100 text-xs font-semibold no-scrollbar" id="categoryTabs"></div>

        <!-- News Feed Container -->
        <div id="newsFeedList" class="mt-3 space-y-3 overflow-y-auto max-h-[580px] flex-grow pr-1"></div>

        <!-- Feed footer info -->
        <div class="mt-3 pt-3 border-t border-slate-100 text-[11px] text-slate-400 flex items-center justify-between">
          <span class="flex items-center gap-1">📖 Points accumulate while modal is open</span>
          <button id="refreshFeedBtn" class="text-amber-800 font-semibold hover:underline flex items-center gap-1">
            🔄 New Dispatches
          </button>
        </div>

      </div>

    </section>

  </main>

  <!-- MODAL 1: SANDBOXED FULL-LENGTH ARTICLE READER WITH DWELL-TIME BONUS ENGINE -->
  <div id="readerModal" class="fixed inset-0 bg-slate-900/75 backdrop-blur-sm z-50 hidden flex items-center justify-center p-2 sm:p-4">
    <div class="bg-white rounded-3xl max-w-2xl w-full h-[92vh] flex flex-col shadow-2xl border border-amber-100 overflow-hidden relative">
      
      <!-- Reader Header -->
      <div class="p-3.5 sm:p-4 border-b border-slate-100 bg-amber-50/70 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-amber-600/10 text-amber-800 flex items-center justify-center text-lg shrink-0">
            📖
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span id="readerModalCategory" class="text-[10px] font-bold uppercase tracking-wider bg-amber-200 text-amber-900 px-2 py-0.5 rounded-md">TECH</span>
              <span id="readerModalSource" class="text-xs text-slate-600 font-semibold truncate max-w-[120px] sm:max-w-xs">Wired</span>
            </div>
            <span class="text-[10px] text-slate-400 font-mono" id="readerModalTime">4 min full read</span>
          </div>
        </div>

        <!-- Active Dwell Bonus Status Ring -->
        <div class="flex items-center gap-2">
          <div id="readerDwellTracker" class="bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-xl flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
            <div class="text-left">
              <span class="block text-[9px] font-bold text-emerald-800 uppercase tracking-tight leading-none">Reading Bonus</span>
              <span id="dwellCountdownText" class="text-[10px] font-mono font-bold text-emerald-700">Next +10 TP: 15s</span>
            </div>
          </div>
          
          <button id="closeReaderBtn" class="text-slate-400 hover:text-slate-700 bg-slate-100 hover:bg-slate-200 w-8 h-8 rounded-full flex items-center justify-center font-bold text-base transition">
            &times;
          </button>
        </div>
      </div>

      <!-- Reader Body: FULL-LENGTH Multi-Paragraph Article Content -->
      <div class="p-5 sm:p-7 overflow-y-auto space-y-4 flex-grow text-slate-700 leading-relaxed text-sm sm:text-base selection:bg-amber-100">
        <h2 id="readerModalTitle" class="font-display font-bold text-xl sm:text-2xl text-slate-900 leading-snug">
          Article Headline
        </h2>
        
        <div class="text-xs text-slate-400 flex items-center gap-2 pb-2 border-b border-slate-100">
          <span>By <strong id="readerModalAuthor" class="text-slate-700">Staff Correspondent</strong></span>
          <span>•</span>
          <span id="readerModalDate">Today</span>
          <span>•</span>
          <span class="text-emerald-700 font-semibold">Verified Sandbox Dispatch</span>
        </div>

        <div id="readerModalContent" class="space-y-4 font-sans text-slate-700 leading-7 text-sm sm:text-base">
          <!-- Multi-paragraph rich article injected here dynamically -->
        </div>
      </div>

      <!-- Reader Footer: Keep Sandboxed & Safe External Link -->
      <div class="p-3 sm:p-4 border-t border-slate-100 bg-slate-50 flex items-center justify-between text-xs">
        <span class="text-slate-500 hidden sm:inline">Accumulating dwell points inside sandbox</span>

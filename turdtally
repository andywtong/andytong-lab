  <!-- Core JavaScript Engine -->
  <script>
    /* ==========================================================================
       1. WEB AUDIO API SYNTHESIZER
       ========================================================================== */
    class ThroneSoundEngine {
      constructor() {
        this.ctx = null;
      }

      init() {
        if (!this.ctx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (AudioContext) this.ctx = new AudioContext();
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }

      playChime() {
        try {
          this.init();
          if (!this.ctx) return;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(587.33, this.ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(880, this.ctx.currentTime + 0.15);
          gain.gain.setValueAtTime(0.12, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.35);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + 0.35);
        } catch (e) {}
      }

      playPointBonus() {
        try {
          this.init();
          if (!this.ctx) return;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(659.25, this.ctx.currentTime);
          osc.frequency.setValueAtTime(987.77, this.ctx.currentTime + 0.08);
          gain.gain.setValueAtTime(0.18, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.25);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + 0.25);
        } catch (e) {}
      }

      playFlush() {
        try {
          this.init();
          if (!this.ctx) return;
          const bufferSize = this.ctx.sampleRate * 2.2;
          const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
          const data = buffer.getChannelData(0);
          for (let i = 0; i < bufferSize; i++) {
            data[i] = Math.random() * 2 - 1;
          }
          const noise = this.ctx.createBufferSource();
          noise.buffer = buffer;
          const filter = this.ctx.createBiquadFilter();
          filter.type = 'bandpass';
          filter.frequency.setValueAtTime(700, this.ctx.currentTime);
          filter.frequency.exponentialRampToValueAtTime(1400, this.ctx.currentTime + 0.7);
          filter.frequency.exponentialRampToValueAtTime(250, this.ctx.currentTime + 2.0);
          filter.Q.setValueAtTime(2.5, this.ctx.currentTime);

          const gain = this.ctx.createGain();
          gain.gain.setValueAtTime(0.01, this.ctx.currentTime);
          gain.gain.linearRampToValueAtTime(0.35, this.ctx.currentTime + 0.3);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 2.1);

          noise.connect(filter);
          filter.connect(gain);
          gain.connect(this.ctx.destination);
          noise.start();
          noise.stop(this.ctx.currentTime + 2.2);
        } catch (e) {}
      }
    }

    const sound = new ThroneSoundEngine();

    /* ==========================================================================
       2. STATE & LOCAL PERSISTENCE
       ========================================================================== */
    const STORAGE_KEY = 'turdtally_throne_v2';

    const DEFAULT_NAMES = [
      'SirFlushesAlot', 'PlungerPat_42', 'DuchessOfDumps', 'CaptainClogger_99',
      'ThePorcelainKing', 'ThroneRaider_007', 'LordOfLoo', 'FlushGordon_88',
      'BaronVonBowels', 'PottyPotentate', 'StallStalker_23', 'BidetBandit'
    ];

    const ALL_AVAILABLE_TOPICS = [
      { id: 'tech', label: '💻 Tech' },
      { id: 'finance', label: '📈 Finance' },
      { id: 'science', label: '🔬 Science' },
      { id: 'world', label: '🌍 World News' },
      { id: 'weird', label: '🤪 Weird News' },
      { id: 'history', label: '📜 History' },
      { id: 'ai', label: '🤖 AI & Startups' },
      { id: 'gaming', label: '🎮 Gaming' },
      { id: 'popculture', label: '🎬 Pop Culture' },
      { id: 'sports', label: '⚽ Sports' }
    ];

    function getRandomThroneName() {
      const base = DEFAULT_NAMES[Math.floor(Math.random() * DEFAULT_NAMES.length)];
      return `${base}_${Math.floor(10 + Math.random() * 89)}`;
    }

    const AppState = {
      user: {
        throneName: getRandomThroneName(),
        wageType: 'hourly',
        hourlyRate: 35.00,
        annualSalary: 72800,
        hoursPerWeek: 40,
        selectedTopics: ['tech', 'finance', 'science', 'weird', 'history'],
        customCategories: []
      },
      currentSession: {
        active: false,
        paused: false,
        elapsedSeconds: 0,
        currentEarnings: 0,
        poopPoints: 0,       // Points accumulated purely by stall duration
        readingPoints: 0     // Points accumulated by active article reading
      },
      reader: {
        isOpen: false,
        activeArticle: null,
        dwellTimer: 15
      },
      sessions: []
    };

    function loadState() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          const parsed = JSON.parse(saved);
          if (parsed.user) AppState.user = { ...AppState.user, ...parsed.user };
          if (Array.isArray(parsed.sessions)) AppState.sessions = parsed.sessions;
        }
      } catch (e) {
        console.error('Failed to load storage:', e);
      }
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({
          user: AppState.user,
          sessions: AppState.sessions
        }));
      } catch (e) {
        console.error('Failed to save storage:', e);
      }
    }

    function getDollarPerSecond() {
      if (AppState.user.wageType === 'salary') {
        const totalYearHours = (AppState.user.hoursPerWeek || 40) * 52;
        const hourly = AppState.user.annualSalary / Math.max(1, totalYearHours);
        return hourly / 3600;
      }
      return (AppState.user.hourlyRate || 35) / 3600;
    }

    function getHourlyEquivalent() {
      if (AppState.user.wageType === 'salary') {
        const totalYearHours = (AppState.user.hoursPerWeek || 40) * 52;
        return AppState.user.annualSalary / Math.max(1, totalYearHours);
      }
      return AppState.user.hourlyRate;
    }

    function updateRateBadges() {
      const perSec = getDollarPerSecond();
      const hourly = getHourlyEquivalent();
      const bannerDisplay = document.getElementById('prominentWageDisplay');
      if (bannerDisplay) {
        bannerDisplay.textContent = `$${hourly.toFixed(2)}/hr ($${perSec.toFixed(4)}/sec)`;
      }
    }

    /* ==========================================================================
       3. TRACKING ENGINE TIMERS & CONDITIONAL READING BONUS
       ========================================================================== */
    let tickerInterval = null;
    let readingBonusInterval = null;
    let peerTickerInterval = null;
    let currentSortMode = 'earnings';

    function formatTime(seconds) {
      const m = Math.floor(seconds / 60);
      const s = Math.floor(seconds % 60);
      const tenths = Math.floor((seconds % 1) * 10);
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}<span class="text-2xl text-slate-400">.${tenths}</span>`;
    }

    function formatTimeShort(seconds) {
      const m = Math.floor(seconds / 60);
      const s = Math.floor(seconds % 60);
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    }

    function formatDurationClean(sec) {
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      return `${m}m ${s}s`;
    }

    function triggerBonusBadge(text = '+10 TP') {
      const container = document.getElementById('badgeContainer');
      if (!container) return;
      const badge = document.createElement('div');
      badge.className = 'font-display font-extrabold text-sm text-emerald-600 bg-white px-2.5 py-1 rounded-full shadow-md border border-emerald-300 animate-floatBadge select-none';
      badge.textContent = text;
      container.appendChild(badge);
      setTimeout(() => badge.remove(), 1400);
    }

    function tick() {
      if (!AppState.currentSession.active || AppState.currentSession.paused) return;

      AppState.currentSession.elapsedSeconds += 0.1;
      const ratePerSec = getDollarPerSecond();
      AppState.currentSession.currentEarnings += ratePerSec * 0.1;

      // Base time points: 1 point every 2 seconds
      if (Math.round(AppState.currentSession.elapsedSeconds * 10) % 20 === 0) {
        AppState.currentSession.poopPoints += 1;
      }

      const totalPoints = AppState.currentSession.poopPoints + AppState.currentSession.readingPoints;

      // Update Main View
      document.getElementById('sessionTimer').innerHTML = formatTime(AppState.currentSession.elapsedSeconds);
      document.getElementById('liveMoneyTally').textContent = `$${AppState.currentSession.currentEarnings.toFixed(3)}`;
      document.getElementById('livePointsTally').innerHTML = `${totalPoints} <span class="text-sm font-normal text-amber-700">TP</span>`;
      document.getElementById('livePoopPoints').textContent = `${AppState.currentSession.poopPoints} TP`;
      document.getElementById('liveReadingPoints').textContent = `${AppState.currentSession.readingPoints} TP`;

      // Update Sticky Bar
      document.getElementById('stickyTimer').textContent = formatTimeShort(AppState.currentSession.elapsedSeconds);
      document.getElementById('stickyMoney').textContent = `$${AppState.currentSession.currentEarnings.toFixed(2)}`;
      document.getElementById('stickyPoints').textContent = `${totalPoints} TP`;
    }

    // Secondary 1-second interval strictly managing the reading dwell requirement
    function readingTick() {
      const countdownEl = document.getElementById('dwellCountdownText');
      const activeIndicator = document.getElementById('activeReaderIndicator');

      if (AppState.currentSession.active && !AppState.currentSession.paused && AppState.reader.isOpen) {
        activeIndicator.classList.remove('hidden');
        AppState.reader.dwellTimer -= 1;

        if (countdownEl) {
          countdownEl.textContent = `Next +10 TP: ${AppState.reader.dwellTimer}s`;
        }

        if (AppState.reader.dwellTimer <= 0) {
          AppState.currentSession.readingPoints += 10;
          AppState.reader.dwellTimer = 15;
          sound.playPointBonus();
          triggerBonusBadge('+10 TP Reading Bonus!');

          const totalPoints = AppState.currentSession.poopPoints + AppState.currentSession.readingPoints;
          document.getElementById('livePointsTally').innerHTML = `${totalPoints} <span class="text-sm font-normal text-amber-700">TP</span>`;
          document.getElementById('liveReadingPoints').textContent = `${AppState.currentSession.readingPoints} TP`;
          document.getElementById('stickyPoints').textContent = `${totalPoints} TP`;
        }
      } else {
        activeIndicator.classList.add('hidden');
        if (countdownEl) {
          countdownEl.textContent = AppState.currentSession.active ? 'Paused / Reader Closed' : 'Start mission to earn';
        }
      }
    }

    function updateSessionButtonStates(isRunning) {
      const startBtn = document.getElementById('startBtn');
      const startIcon = document.getElementById('startBtnIcon');
      const startText = document.getElementById('startBtnText');

      const stickyBtn = document.getElementById('stickyToggleBtn');
      const stickyIcon = document.getElementById('stickyToggleIcon');
      const stickyText = document.getElementById('stickyToggleText');

      if (isRunning) {
        // Change button to Finished Mission
        startBtn.className = 'w-full py-3.5 px-5 rounded-2xl font-display font-bold text-base text-white bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 active:scale-[0.98] transition shadow-lg shadow-emerald-700/20 flex items-center justify-center gap-2';
        startIcon.textContent = '🏁';
        startText.textContent = 'Finished Mission';

        stickyBtn.className = 'px-3.5 py-1.5 rounded-xl font-display font-bold text-xs sm:text-sm text-white bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 active:scale-95 transition shadow-sm flex items-center gap-1.5 whitespace-nowrap';
        stickyIcon.textContent = '🏁';
        stickyText.textContent = 'Finished Mission';
      } else {
        startBtn.className = 'w-full py-3.5 px-5 rounded-2xl font-display font-bold text-base text-white bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-700 hover:to-amber-800 active:scale-[0.98] transition shadow-lg shadow-amber-700/20 flex items-center justify-center gap-2';
        startIcon.textContent = '🚽';
        startText.textContent = 'Initiate Mission';

        stickyBtn.className = 'px-3.5 py-1.5 rounded-xl font-display font-bold text-xs sm:text-sm text-white bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-700 active:scale-95 transition shadow-sm flex items-center gap-1.5 whitespace-nowrap';
        stickyIcon.textContent = '🚽';
        stickyText.textContent = 'Initiate Mission';
      }
    }

    function toggleMission() {
      if (!AppState.currentSession.active) {
        startSession();
      } else {
        flushAndLogSession();
      }
    }

    function startSession() {
      sound.playChime();
      AppState.currentSession.active = true;
      AppState.currentSession.paused = false;
      AppState.currentSession.elapsedSeconds = 0;
      AppState.currentSession.currentEarnings = 0;
      AppState.currentSession.poopPoints = 10; // Entry bonus
      AppState.currentSession.readingPoints = 0;

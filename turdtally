<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TurdTally 🧻 The Ultimate Throne Tracker</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts: Fredoka & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  
  <!-- Canvas Confetti for the Victory Flush -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            display: ['Fredoka', 'cursive', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            throne: {
              50: '#fdf8f6',
              100: '#f2e8e5',
              200: '#eaddd7',
              500: '#b08968',
              600: '#7f5539',
              800: '#533c2e',
              900: '#34251c',
            }
          },
          keyframes: {
            floatBadge: {
              '0%': { opacity: '0', transform: 'translateY(10px) scale(0.8)' },
              '30%': { opacity: '1', transform: 'translateY(-10px) scale(1.1)' },
              '100%': { opacity: '0', transform: 'translateY(-35px) scale(0.9)' }
            }
          },
          animation: {
            floatBadge: 'floatBadge 1.4s ease-out forwards',
          }
        }
      }
    }
  </script>

  <style>
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    .tabular-nums { font-variant-numeric: tabular-nums; }
  </style>
</head>
<body class="bg-amber-50/40 text-slate-800 font-sans min-h-screen flex flex-col antialiased selection:bg-amber-200 selection:text-amber-900">

  <!-- Top Navigation Bar -->
  <header class="bg-white/80 backdrop-blur-md sticky top-0 z-40 border-b border-amber-100/80 px-4 py-3 sm:px-6">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <!-- Logo -->
      <div class="flex items-center space-x-2">
        <span class="text-3xl filter drop-shadow">🧻</span>
        <div>
          <h1 class="text-2xl font-bold font-display tracking-tight text-amber-900 flex items-center gap-1.5 leading-none">
            TurdTally <span class="text-[10px] bg-emerald-100 text-emerald-800 font-sans font-bold px-2 py-0.5 rounded-full border border-emerald-200">WEALTH RECLAIMER</span>
          </h1>
          <p class="text-[11px] text-amber-700/80 font-medium">Reclaiming corporate wealth, drop by drop</p>
        </div>
      </div>

      <!-- User Profile Badge -->
      <div class="flex items-center gap-2">
        <button id="profileBtn" class="flex items-center gap-2 bg-amber-100/60 hover:bg-amber-100 border border-amber-200/80 px-3.5 py-1.5 rounded-xl transition shadow-sm text-sm font-medium text-amber-950">
          <span class="text-base">👑</span>
          <span id="navThroneName" class="font-display font-semibold truncate max-w-[130px] sm:max-w-xs">PlungerKing_99</span>
          <span class="text-xs opacity-60">✏️</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content Layout -->
  <main class="flex-grow max-w-6xl mx-auto w-full p-4 sm:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6">

    <!-- LEFT COLUMN: Tracker Dashboard & Controls (lg:col-span-7) -->
    <section class="lg:col-span-7 space-y-6">
      
      <!-- Primary Throne Counter Card -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-xl shadow-amber-950/5 border border-amber-100/80 relative overflow-hidden">
        
        <div class="absolute -right-10 -bottom-10 text-9xl text-amber-50/50 pointer-events-none select-none font-display">🚽</div>
        
        <!-- Status indicator bar -->
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <span id="sessionStatusDot" class="w-3 h-3 rounded-full bg-slate-300"></span>
            <span id="sessionStatusText" class="text-xs font-bold tracking-wider uppercase text-slate-400">Throne Vacant</span>
          </div>
          <div id="activeReaderIndicator" class="hidden text-xs bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-0.5 rounded-full font-semibold animate-pulse">
            📖 Reading Modal Active (+10 TP loop)
          </div>
        </div>

        <!-- Timer Display -->
        <div class="text-center my-3">
          <div id="sessionTimer" class="font-mono text-5xl sm:text-6xl font-extrabold text-slate-800 tracking-tight tabular-nums">
            00:00<span class="text-2xl text-slate-400">.0</span>
          </div>
          <p class="text-xs text-slate-400 mt-1 uppercase tracking-widest font-semibold">Active Session Duration</p>
        </div>

        <!-- Dual Live Ticker Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-5 relative">
          
          <!-- Box 1: Money Reclaimed -->
          <div class="bg-gradient-to-br from-emerald-500/10 via-emerald-500/5 to-transparent border border-emerald-200/80 rounded-2xl p-4 text-center relative overflow-hidden">
            <span class="text-xs font-bold text-emerald-800 uppercase tracking-wider block mb-1">Corporate Pay Reclaimed</span>
            <div class="font-mono text-3xl sm:text-4xl font-extrabold text-emerald-600 tabular-nums" id="liveMoneyTally">
              $0.000
            </div>
            <p class="text-[11px] text-emerald-700/80 mt-1 font-medium">Boss makes a dollar, you make a dime</p>
          </div>

          <!-- Box 2: TurdPoints (Gamification) -->
          <div class="bg-gradient-to-br from-amber-500/10 via-amber-500/5 to-transparent border border-amber-200/80 rounded-2xl p-4 text-center relative overflow-hidden">
            <span class="text-xs font-bold text-amber-800 uppercase tracking-wider block mb-1">TurdPoints™ Earned</span>
            <div class="font-mono text-3xl sm:text-4xl font-extrabold text-amber-600 tabular-nums flex items-center justify-center gap-1" id="livePointsTally">
              0 <span class="text-sm font-normal text-amber-700">TP</span>
            </div>
            <p class="text-[11px] text-amber-700/80 mt-1" id="pointsSubtext">Active reading lounge bonus enabled</p>
            
            <div id="badgeContainer" class="absolute inset-0 pointer-events-none flex items-center justify-center"></div>
          </div>
        </div>

        <!-- HIGH-VISIBILITY PROMINENT WAGE CONFIGURATION BANNER -->
        <div class="my-4">
          <button id="prominentWageBtn" class="w-full p-3.5 rounded-2xl bg-amber-50 hover:bg-amber-100/80 border-2 border-dashed border-amber-300 hover:border-amber-400 transition flex items-center justify-between group shadow-sm">
            <div class="flex items-center gap-3 text-left">
              <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-900 flex items-center justify-center text-xl shrink-0">
                💰
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold text-amber-900 tracking-wide uppercase">Your Compensation Rate</span>
                  <span class="text-[10px] font-semibold bg-amber-200 text-amber-900 px-2 py-0.2 rounded-full">Tap to Edit</span>
                </div>
                <div id="prominentWageDisplay" class="font-mono font-bold text-slate-800 text-sm sm:text-base">
                  $35.00/hr ($0.0097/sec)
                </div>
              </div>
            </div>
            <div class="text-amber-800 text-xs font-bold flex items-center gap-1 px-3 py-1.5 rounded-xl bg-white shadow-xs group-hover:scale-105 transition">
              <span>⚙️ Adjust</span>
            </div>
          </button>
        </div>

        <!-- Core Session Control Buttons -->
        <div class="space-y-3">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <button id="startBtn" class="w-full py-4 px-6 rounded-2xl font-display font-bold text-lg text-white bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-700 hover:to-amber-800 active:scale-[0.98] transition shadow-lg shadow-amber-700/25 flex items-center justify-center gap-2">
              <span>🚽</span> Initiate Mission
            </button>
            
            <button id="pauseBtn" disabled class="w-full py-4 px-6 rounded-2xl font-display font-bold text-lg text-slate-700 bg-slate-100 hover:bg-slate-200 disabled:opacity-40 disabled:cursor-not-allowed active:scale-[0.98] transition flex items-center justify-center gap-2 border border-slate-200">
              <span id="pauseBtnIcon">⏸️</span> <span id="pauseBtnText">Hold It (Pause)</span>
            </button>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
            <button id="flushBtn" disabled class="w-full py-3 px-5 rounded-2xl font-display font-bold text-base text-white bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 disabled:opacity-40 disabled:cursor-not-allowed active:scale-[0.98] transition shadow-md shadow-emerald-700/20 flex items-center justify-center gap-2">
              <span>🌊</span> Flush & Log
            </button>
            
            <button id="abortBtn" disabled class="w-full py-3 px-5 rounded-2xl font-display font-semibold text-base text-rose-600 bg-rose-50 hover:bg-rose-100 disabled:opacity-40 disabled:cursor-not-allowed active:scale-[0.98] transition border border-rose-200/80 flex items-center justify-center gap-2">
              <span>🛑</span> Abort Mission
            </button>
          </div>
        </div>
      </div>

      <!-- Lifetime Stats Cards Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="bg-white p-4 rounded-2xl border border-amber-100/80 shadow-sm text-center">
          <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block">Career Paid</span>
          <span id="statTotalPay" class="font-mono text-xl sm:text-2xl font-bold text-emerald-600 tabular-nums">$0.00</span>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-amber-100/80 shadow-sm text-center">
          <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block">Total Flushes</span>
          <span id="statTotalFlushes" class="font-mono text-xl sm:text-2xl font-bold text-slate-800 tabular-nums">0</span>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-amber-100/80 shadow-sm text-center">
          <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block">Throne Time</span>
          <span id="statTotalTime" class="font-mono text-lg sm:text-xl font-bold text-amber-900 tabular-nums">0m</span>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-amber-100/80 shadow-sm text-center">
          <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block">Avg Flush Value</span>
          <span id="statAvgValue" class="font-mono text-xl sm:text-2xl font-bold text-amber-700 tabular-nums">$0.00</span>
        </div>
      </div>

      <!-- Local Leaderboard & Hall of Flushes -->
      <div class="bg-white rounded-3xl p-6 shadow-sm border border-amber-100/80">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4 pb-3 border-b border-slate-100">
          <div>
            <h3 class="font-display font-bold text-lg text-slate-800 flex items-center gap-2">
              🏆 Hall of Flushes (Personal Best & Logs)
            </h3>
            <p class="text-xs text-slate-500">100% private local storage persistence</p>
          </div>

          <div class="inline-flex rounded-xl bg-slate-100 p-1 text-xs font-semibold self-start sm:self-auto">
            <button id="sortEarningsBtn" class="px-3 py-1 rounded-lg bg-white shadow-xs text-slate-800">Top Pay 💵</button>
            <button id="sortPointsBtn" class="px-3 py-1 rounded-lg text-slate-500 hover:text-slate-800">TurdPoints ⭐</button>
            <button id="sortRecentBtn" class="px-3 py-1 rounded-lg text-slate-500 hover:text-slate-800">Recent 🕒</button>
          </div>
        </div>

        <div id="sessionHistoryList" class="space-y-2 max-h-72 overflow-y-auto pr-1"></div>

        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
          <span>Synced locally to your device.</span>
          <button id="clearDataBtn" class="text-rose-500 hover:text-rose-700 font-medium">Reset Data</button>
        </div>
      </div>

      <!-- Monetization / Self-Serve Ad Space -->
      <div class="bg-gradient-to-r from-amber-900 via-amber-800 to-stone-900 text-white rounded-3xl p-5 shadow-lg border border-amber-700/50 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-amber-500/20 border border-amber-400/30 flex items-center justify-center text-2xl shrink-0">
            💼
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-[10px] font-bold tracking-widest uppercase bg-amber-500/30 text-amber-300 px-2 py-0.5 rounded-full">Sponsor Opportunity</span>
              <span class="text-xs text-amber-200/80">Captive Throne Attention</span>
            </div>
            <h4 class="font-display font-bold text-base sm:text-lg mt-0.5">Advertise to captive talent on company time!</h4>
            <p class="text-xs text-amber-200/70">Reach decision-makers when they have nothing else to do.</p>
          </div>
        </div>
        <button id="sponsorBtn" class="whitespace-nowrap w-full sm:w-auto px-4 py-2.5 bg-gradient-to-r from-amber-400 to-amber-300 hover:from-amber-300 hover:to-amber-200 text-amber-950 font-bold rounded-xl text-xs transition shadow font-display">
          Claim Throne Space 🚀
        </button>
      </div>

    </section>

    <!-- RIGHT COLUMN: Gamified Throne Reading Lounge (lg:col-span-5) -->
    <section class="lg:col-span-5 flex flex-col space-y-4">
      
      <div class="bg-white rounded-3xl p-5 sm:p-6 shadow-xl shadow-amber-950/5 border border-amber-100/80 flex-grow flex flex-col">
        
        <!-- Header -->
        <div class="flex items-center justify-between mb-3">
          <div>
            <h2 class="font-display font-bold text-xl text-slate-800 flex items-center gap-2">
              🛋️ Throne Reading Lounge
            </h2>
            <p class="text-xs text-slate-500">Open & read articles to earn <strong>+10 TP / 15s</strong> active bonus!</p>
          </div>
          
          <button id="customizeTopicsBtn" class="text-xs bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 px-2.5 py-1 rounded-xl font-bold transition flex items-center gap-1">
            <span>⚙️</span> Topics
          </button>
        </div>

        <!-- News Category Tabs: Top 5 Active Topics -->
        <div class="flex gap-1.5 overflow-x-auto pb-2 border-b border-slate-100 text-xs font-semibold no-scrollbar" id="categoryTabs">
          <!-- Dynamically populated from active top 5 topics -->
        </div>

        <!-- News Feed Container -->
        <div id="newsFeedList" class="mt-4 space-y-3 overflow-y-auto max-h-[560px] flex-grow pr-1">
          <!-- Injected dynamically -->
        </div>

        <!-- Feed footer info -->
        <div class="mt-3 pt-3 border-t border-slate-100 text-[11px] text-slate-400 flex items-center justify-between">
          <span class="flex items-center gap-1">💡 Click an article to open sandboxed reader</span>
          <button id="refreshFeedBtn" class="text-amber-800 font-semibold hover:underline flex items-center gap-1">
            🔄 New Dispatches
          </button>
        </div>

      </div>

    </section>

  </main>

  <!-- MODAL 1: SANDBOXED ARTICLE READER WITH DWELL-TIME BONUS ENGINE -->
  <div id="readerModal" class="fixed inset-0 bg-slate-900/70 backdrop-blur-sm z-50 hidden flex items-center justify-center p-3 sm:p-5">
    <div class="bg-white rounded-3xl max-w-2xl w-full h-[90vh] flex flex-col shadow-2xl border border-amber-100 overflow-hidden relative">
      
      <!-- Reader Header -->
      <div class="p-4 sm:p-5 border-b border-slate-100 bg-amber-50/50 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-amber-600/10 text-amber-800 flex items-center justify-center text-xl shrink-0">
            📖
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span id="readerModalCategory" class="text-[10px] font-bold uppercase tracking-wider bg-amber-200 text-amber-900 px-2 py-0.5 rounded-md">TECH</span>
              <span id="readerModalSource" class="text-xs text-slate-500 font-semibold">Wired</span>
            </div>
            <span class="text-[11px] text-slate-400 font-mono" id="readerModalTime">3 min read</span>
          </div>
        </div>

        <!-- Active Dwell Bonus Status Ring -->
        <div class="flex items-center gap-3">
          <div id="readerDwellTracker" class="bg-emerald-50 border border-emerald-200 px-3 py-1.5 rounded-2xl flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
            <div class="text-left">
              <span class="block text-[10px] font-bold text-emerald-800 uppercase tracking-tight leading-none">Reading Bonus</span>
              <span id="dwellCountdownText" class="text-[11px] font-mono font-bold text-emerald-700">Next +10 TP: 15s</span>
            </div>
          </div>
          
          <button id="closeReaderBtn" class="text-slate-400 hover:text-slate-700 bg-slate-100 hover:bg-slate-200 w-9 h-9 rounded-full flex items-center justify-center font-bold text-lg transition">
            &times;
          </button>
        </div>
      </div>

      <!-- Reader Body -->
      <div class="p-6 sm:p-8 overflow-y-auto space-y-4 flex-grow text-slate-700 leading-relaxed text-sm sm:text-base selection:bg-amber-100">
        <h2 id="readerModalTitle" class="font-display font-bold text-2xl sm:text-3xl text-slate-900 leading-tight">
          Article Headline
        </h2>
        <div class="text-xs text-slate-400 flex items-center gap-2 pb-2 border-b border-slate-100">
          <span>By <strong id="readerModalAuthor" class="text-slate-700">Staff Writer</strong></span>
          <span>•</span>
          <span id="readerModalDate">Today</span>
        </div>
        <div id="readerModalContent" class="space-y-4 font-sans text-slate-600 leading-7">
          <!-- Text inserted dynamically -->
        </div>
      </div>

      <!-- Reader Footer -->
      <div class="p-4 border-t border-slate-100 bg-slate-50/80 flex items-center justify-between text-xs">
        <span class="text-slate-500">Sandboxed in-app distraction-free mode</span>
        <button id="openExternalSourceBtn" class="px-3.5 py-1.5 bg-white hover:bg-slate-100 border border-slate-200 rounded-xl text-slate-700 font-semibold transition flex items-center gap-1.5">
          <span>Open External Source</span> ↗
        </button>
      </div>

    </div>
  </div>

  <!-- MODAL 2: CUSTOMIZE TOPICS & REQUEST CATEGORY -->
  <div id="topicsModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-amber-100 max-h-[90vh] flex flex-col">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <div>
          <h3 class="font-display font-bold text-xl text-slate-800 flex items-center gap-2">
            ⚙️ Throne Reading Topics
          </h3>
          <p class="text-xs text-slate-500">Pick up to 5 favorite topics to display in your reading bar.</p>
        </div>
        <button id="closeTopicsBtn" class="text-slate-400 hover:text-slate-600 text-xl font-bold p-1">&times;</button>
      </div>

      <div class="py-4 overflow-y-auto space-y-4 flex-grow">
        <!-- Topic checklist -->
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase mb-2">Available Topics (<span id="selectedTopicsCount">5</span>/5 selected)</label>
          <div id="topicsGrid" class="grid grid-cols-2 gap-2 text-xs">
            <!-- Injected dynamically -->
          </div>
        </div>

        <!-- Request / Add Custom Category -->
        <div class="bg-amber-50 rounded-2xl p-4 border border-amber-200/70 space-y-2">
          <label class="block text-xs font-bold text-amber-900 uppercase">Request or Add New Category</label>
          <div class="flex gap-2">
            <input type="text" id="customCategoryInput" placeholder="e.g. Psychology, Crypto, Anime..." maxlength="20" class="flex-1 px-3 py-2 rounded-xl border border-amber-200 text-xs focus:outline-none focus:ring-2 focus:ring-amber-500 font-semibold" />
            <button id="addCustomCategoryBtn" class="px-4 py-2 bg-amber-800 hover:bg-amber-900 text-white font-bold rounded-xl text-xs transition">
              + Add
            </button>
          </div>
          <p class="text-[11px] text-amber-800/80">Add custom topics to automatically seed procedural dispatches!</p>
        </div>
      </div>

      <div class="pt-3 border-t border-slate-100 flex justify-end gap-2">
        <button id="saveTopicsBtn" class="py-2.5 px-6 bg-amber-800 hover:bg-amber-900 text-white font-display font-bold rounded-xl text-sm transition">
          Apply Topics
        </button>
      </div>
    </div>
  </div>

  <!-- MODAL 3: WAGE & COMPENSATION CONFIG (Prominently triggered) -->
  <div id="settingsModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-amber-100">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
        <h3 class="font-display font-bold text-xl text-slate-800 flex items-center gap-2">
          💰 Set Hourly Wage & Salary
        </h3>
        <button id="closeSettingsBtn" class="text-slate-400 hover:text-slate-600 text-xl font-bold p-1">&times;</button>
      </div>

      <div class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase mb-2">Compensation Format</label>
          <div class="grid grid-cols-2 gap-2">
            <button id="wageTypeHourly" class="py-2.5 px-3 rounded-xl border-2 border-amber-800 bg-amber-50 text-amber-900 font-bold text-sm">Hourly Wage ($/hr)</button>
            <button id="wageTypeSalary" class="py-2.5 px-3 rounded-xl border border-slate-200 bg-white text-slate-600 font-semibold text-sm">Annual Salary ($/yr)</button>
          </div>
        </div>

        <div>
          <label id="wageInputLabel" class="block text-xs font-semibold text-slate-700 mb-1">Hourly Rate (USD $)</label>
          <div class="relative">
            <span class="absolute left-3.5 top-3 text-slate-400 font-bold text-base">$</span>
            <input type="number" id="wageInput" step="0.25" min="1" value="35.00" class="w-full pl-8 pr-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 font-mono font-bold text-lg text-slate-800" />
          </div>

    function abortSession() {
      const dialog = confirm("Abort mission? All earnings and points accumulated during this stall break will be discarded!");
      if (!dialog) return;
      resetSessionUI();
    }

    function flushAndLogSession() {
      if (!AppState.currentSession.active) return;
      sound.playFlush();
      if (window.confetti) {
        confetti({
          particleCount: 90,
          spread: 80,
          origin: { y: 0.6 },
          colors: ['#10b981', '#f59e0b', '#3b82f6', '#b08968']
        });
      }

      const poopPts = AppState.currentSession.poopPoints;
      const readPts = AppState.currentSession.readingPoints;
      const totalPts = poopPts + readPts;

      const newRecord = {
        id: 'flush_' + Date.now(),
        throneName: AppState.user.throneName,
        durationSeconds: AppState.currentSession.elapsedSeconds,
        earnings: AppState.currentSession.currentEarnings,
        poopPoints: poopPts,
        readingPoints: readPts,
        points: totalPts,
        timestamp: new Date().toISOString()
      };

      AppState.sessions.unshift(newRecord);
      saveState();
      renderHistoryAndStats();

      // Show summary breakdown modal
      showSummaryModal(newRecord);

      resetSessionUI();
    }

